#!/bin/bash
#
# MyJarbis Project Initialization Script
#

set -e

# Minimal palette: blood red as the only accent, bold + dim for hierarchy.
RED='\033[38;5;88m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# Paths
INSTALL_DIR="${MYJARBIS_INSTALL_DIR:-$HOME/.myjarbis-global}"
TEMPLATES_DIR="$INSTALL_DIR/templates"
REGISTRY_FILE="${MYJARBIS_REGISTRY:-$INSTALL_DIR/projects-registry.json}"
CURRENT_DIR="$(pwd)"
PROJECT_NAME="$(basename "$CURRENT_DIR")"

# ─── flags ────────────────────────────────────────────────────────
# Kept parseable from scripts: init has to run unattended in CI and in the
# test suite, where every `read` is a hang or an immediate `set -e` exit.
ASSUME_YES="${MYJARBIS_ASSUME_YES:-}"
SKIP_MEMORY=""
ORG_SLUG="${MYJARBIS_ORG:-}"
ISOLATION=""
PACK_PATH=""
LANG_FLAG=""
PERSONA_FLAG=""
ASK=""
LIST=""
# Everything except the paths, so each project of a batch is initialised with
# exactly the options the user typed once.
PASSTHROUGH=()
TARGETS=()

for arg in "$@"; do
    case "$arg" in
        --yes|-y)        ASSUME_YES=1 ;;
        --skip-memory)   SKIP_MEMORY=1 ;;
        --org=*)         ORG_SLUG="${arg#*=}" ;;
        --language=*)    LANG_FLAG="${arg#*=}" ;;
        --persona=*)     PERSONA_FLAG="${arg#*=}" ;;
        --ask)           ASK=1 ;;
        --list)          LIST=1; continue ;;
        # Accepted here AND forwarded below. cli.ts has understood both since
        # v0.3, but this script neither parsed nor passed them, so they were
        # unreachable from `myjarbis init` — --isolation=shared in particular,
        # which is the only way to create a project in the shared brain.
        --isolation=*)   ISOLATION="${arg#*=}" ;;
        --pack-path=*)   PACK_PATH="${arg#*=}" ;;
        --help|-h)
            echo "Usage: myjarbis init [<dir>...] [--yes] [--skip-memory] [--org=<slug>]"
            echo "                     [--isolation=silo|shared] [--pack-path=<dir>]"
            echo "                     [--language=EN|ES|PT] [--persona=<1-4|name>] [--ask]"
            echo "       myjarbis init --list [<folder>]"
            echo
            echo "  --list [<folder>]   Pick the projects to initialise from a list of the"
            echo "                      git repositories in <folder> (default: the last"
            echo "                      folder you listed, else the current one). You can"
            echo "                      walk into subfolders and pick across several."
            echo "  <dir>...            Initialise these projects instead of the current"
            echo "                      directory, in one run. Directories that are not"
            echo "                      git repositories, or are already initialised, are"
            echo "                      skipped (pass --yes to reinitialise those)."
            echo "  --yes, -y           Do not prompt; accept reinitialization."
            echo "  --skip-memory       Leave Claude Code's MEMORY.md untouched."
            echo "  --language=<lang>   Language for this run, over the saved default."
            echo "  --persona=<p>       Persona for this run, over the saved default."
            echo "  --ask               Ignore the saved defaults and ask again; the"
            echo "                      answers become the new defaults."
            echo "  --org=<slug>        Seed this project from a registered org pack."
            echo "  --isolation=<mode>  Where the rows live: 'silo' (default, its"
            echo "                      own .myjarbis/memory.db) or 'shared' (the"
            echo "                      brain at ~/.myjarbis/memory.db)."
            echo "  --pack-path=<dir>   Use a pack from this path instead of a"
            echo "                      registered one. Implies --org."
            exit 0
            ;;
        -*)
            echo "Unknown option: $arg (try --help)" >&2
            exit 1
            ;;
        *)
            TARGETS+=("$arg")
            continue
            ;;
    esac
    PASSTHROUGH+=("$arg")
done

if [ -n "$ISOLATION" ] && [ "$ISOLATION" != "silo" ] && [ "$ISOLATION" != "shared" ]; then
    echo "--isolation must be \"silo\" or \"shared\" (got \"$ISOLATION\")" >&2
    exit 1
fi

# ─── helpers ──────────────────────────────────────────────────────
section() { echo; echo -e "${RED}${BOLD}$1${NC}"; }
step()    { echo -e "${RED}[$1/9]${NC}  ${BOLD}$2${NC}"; }
ok()      { echo -e "       OK"; }
note()    { echo -e "       ${DIM}$1${NC}"; }
warn()    { echo -e "       ${RED}WARN${NC}  $1"; }
tilde()   { case "$1" in "$HOME"*) echo "~${1#"$HOME"}" ;; *) echo "$1" ;; esac; }
lower()   { echo "$1" | tr '[:upper:]' '[:lower:]'; }

# ─── defaults: asked once, reused by every project after ──────────
# Language and persona are a person's, not a project's. Asking them again on
# every init is what made a second project cost as much as the first. They
# live under MYJARBIS_HOME, not INSTALL_DIR, because a reinstall wipes the
# latter and should not forget who the user is.
DEFAULTS_FILE="${MYJARBIS_HOME:-$HOME/.myjarbis}/defaults.json"

default_get() {
    [ -f "$DEFAULTS_FILE" ] || return 0
    node -e '
        try {
            const d = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
            if (d[process.argv[2]] != null) console.log(d[process.argv[2]]);
        } catch {}
    ' "$DEFAULTS_FILE" "$1"
}

default_set() {
    mkdir -p "$(dirname "$DEFAULTS_FILE")"
    node -e '
        const fs = require("fs");
        const f = process.argv[1];
        let d = {};
        try { d = JSON.parse(fs.readFileSync(f, "utf8")); } catch {}
        for (let i = 2; i < process.argv.length; i += 2) d[process.argv[i]] = process.argv[i + 1];
        fs.writeFileSync(f, JSON.stringify(d, null, 2) + "\n");
    ' "$DEFAULTS_FILE" "$@"
}

# Precedence: --language/--persona, then the env vars, then the saved
# defaults (unless --ask), then a prompt, then EN / concise. Only answers
# typed at a prompt are saved: a flag or env var is a choice for one run, and
# CI must not rewrite a developer's defaults.
resolve_style() {
    LANG_CHOICE="${LANG_FLAG:-${MYJARBIS_LANGUAGE:-}}"
    PERSONA_CHOICE="${PERSONA_FLAG:-${MYJARBIS_PERSONA:-}}"
    STYLE_FROM_DEFAULTS=""
    local asked=""

    if [ -z "$ASK" ]; then
        if [ -z "$LANG_CHOICE" ]; then
            LANG_CHOICE="$(default_get language)"
            [ -z "$LANG_CHOICE" ] || STYLE_FROM_DEFAULTS=1
        fi
        if [ -z "$PERSONA_CHOICE" ]; then
            PERSONA_CHOICE="$(default_get persona)"
            [ -z "$PERSONA_CHOICE" ] || STYLE_FROM_DEFAULTS=1
        fi
    fi

    if [ -t 0 ] && [ -z "$LANG_CHOICE" ]; then
        echo
        echo -e "       ${BOLD}Language for the /jarbis prompt${NC}"
        echo -e "         EN  English (United States) ${DIM}[default]${NC}"
        echo -e "         ES  Español (Argentina)"
        echo -e "         PT  Português (Brazil)"
        read -p "       Choice [EN]: " LANG_CHOICE
        LANG_CHOICE="${LANG_CHOICE:-EN}"
        asked=1
    fi
    if [ -t 0 ] && [ -z "$PERSONA_CHOICE" ]; then
        echo
        echo -e "       ${BOLD}Personas${NC}"
        echo -e "         1   Concise            ${DIM}terse, no preamble [default]${NC}"
        echo -e "         2   Pair programmer    ${DIM}1-line intent before each change${NC}"
        echo -e "         3   Mentor             ${DIM}WHAT/WHY/HOW/BENEFITS${NC}"
        echo -e "         4   Critical reviewer  ${DIM}challenges your assumptions first${NC}"
        read -p "       Choice [1]: " PERSONA_CHOICE
        PERSONA_CHOICE="${PERSONA_CHOICE:-1}"
        asked=1
    fi

    LANG_CHOICE="${LANG_CHOICE:-EN}"
    LANG_CHOICE=$(echo "$LANG_CHOICE" | tr '[:lower:]' '[:upper:]')
    PERSONA_CHOICE="${PERSONA_CHOICE:-1}"
    case "$LANG_CHOICE" in
        EN|ES|PT) ;;
        *) echo "Language must be EN, ES or PT (got \"$LANG_CHOICE\")" >&2; exit 1 ;;
    esac

    if [ -n "$asked" ]; then
        default_set language "$LANG_CHOICE" persona "$PERSONA_CHOICE"
        echo
        note "saved as your default for every next project ($(tilde "$DEFAULTS_FILE"))"
        note "change it with: myjarbis init --ask"
    fi
}

# ─── --list: pick the projects from a folder ──────────────────────
# A project is a directory holding a .git. A folder without one is offered
# as a place to walk into when it holds projects, so a tree like
# ~/code/{work,personal}/<repo> is reachable without knowing it in advance.
# Written for bash 3.2, which is what /bin/bash still is on macOS: no
# ${x,,}, no mapfile, no associative arrays.
PICKED=()

is_picked() {
    local p
    for p in "${PICKED[@]}"; do [ "$p" = "$1" ] && return 0; done
    return 1
}

toggle_pick() {
    local p kept=()
    if is_picked "$1"; then
        for p in "${PICKED[@]}"; do [ "$p" = "$1" ] || kept+=("$p"); done
        PICKED=("${kept[@]}")
    else
        PICKED+=("$1")
    fi
}

pick_projects() {
    local root="$1" letters="a b c d e f g h i j k l m n o p q r s t u v w x y z"
    local d s n i tok line lo hi matches mark state

    while true; do
        root="$(cd "$root" && pwd)"
        P_DIRS=(); F_DIRS=(); F_COUNTS=()
        for d in "$root"/*/; do
            [ -d "$d" ] || continue
            d="${d%/}"
            case "$(basename "$d")" in node_modules|vendor) continue ;; esac
            if [ -e "$d/.git" ]; then
                P_DIRS+=("$d")
            else
                n=0
                for s in "$d"/*/; do [ -e "${s}.git" ] && n=$((n + 1)); done
                if [ "$n" -gt 0 ]; then F_DIRS+=("$d"); F_COUNTS+=("$n"); fi
            fi
        done
        LETTERS=($letters)

        echo
        echo -e "${RED}${BOLD}MyJarbis${NC} · pick the projects to initialise"
        echo
        echo -e "  ${BOLD}Folder${NC}  $(tilde "$root")"
        echo
        if [ "${#P_DIRS[@]}" -eq 0 ]; then
            echo -e "  ${DIM}no git repositories here${NC}"
        fi
        for i in "${!P_DIRS[@]}"; do
            d="${P_DIRS[$i]}"
            mark="[ ]"; is_picked "$d" && mark="[${RED}x${NC}]"
            state=""; [ -d "$d/.myjarbis" ] && state="already initialised"
            printf "  ${BOLD}%2d${NC})  %b %-30s ${DIM}%s${NC}\n" "$((i + 1))" "$mark" "$(basename "$d")" "$state"
        done
        if [ "${#F_DIRS[@]}" -gt 0 ]; then
            echo
            echo -e "  ${BOLD}Folders${NC} ${DIM}(open one to pick inside it)${NC}"
            for i in "${!F_DIRS[@]}"; do
                [ "$i" -lt 26 ] || break
                printf "  ${BOLD}%2s${NC})  %-34s ${DIM}%s project(s)${NC}\n" "${LETTERS[$i]}" "$(basename "${F_DIRS[$i]}")/" "${F_COUNTS[$i]}"
            done
        fi
        echo
        echo -e "  ${DIM}numbers ('1 3', '2-5', 'all') toggle · a letter opens a folder · '..' goes up${NC}"
        echo -e "  ${DIM}a path jumps there · Enter when done${NC}  ${BOLD}selected: ${#PICKED[@]}${NC}"
        printf "  ${BOLD}>${NC} "
        read -r line || line=""

        [ -n "${line// /}" ] || break

        for tok in $line; do
            case "$tok" in
                ..)
                    root="$(dirname "$root")"
                    ;;
                all)
                    for d in "${P_DIRS[@]}"; do
                        [ -d "$d/.myjarbis" ] && [ -z "$ASSUME_YES" ] && continue
                        is_picked "$d" || PICKED+=("$d")
                    done
                    ;;
                [a-z])
                    i=0; s=""
                    for d in $letters; do [ "$d" = "$tok" ] && s="$i"; i=$((i + 1)); done
                    if [ -n "$s" ] && [ "$s" -lt "${#F_DIRS[@]}" ]; then
                        root="${F_DIRS[$s]}"
                    else
                        echo -e "  ${RED}no folder '$tok'${NC}"
                    fi
                    ;;
                */*|'~'*)
                    d="${tok/#\~/$HOME}"
                    if [ -d "$d" ]; then root="$d"; else echo -e "  ${RED}not a directory: $tok${NC}"; fi
                    ;;
                *)
                    if [[ "$tok" =~ ^[0-9]+(-[0-9]+)?$ ]]; then
                        lo="${tok%-*}"; hi="${tok#*-}"
                        for ((n = lo; n <= hi; n++)); do
                            if [ "$n" -ge 1 ] && [ "$n" -le "${#P_DIRS[@]}" ]; then
                                toggle_pick "${P_DIRS[$((n - 1))]}"
                            else
                                echo -e "  ${RED}out of range: $n${NC}"
                            fi
                        done
                    else
                        matches=()
                        for d in "${P_DIRS[@]}"; do
                            case "$(lower "$(basename "$d")")" in *"$(lower "$tok")"*) matches+=("$d") ;; esac
                        done
                        if [ "${#matches[@]}" -eq 1 ]; then
                            toggle_pick "${matches[0]}"
                        elif [ "${#matches[@]}" -eq 0 ]; then
                            echo -e "  ${RED}no project matches '$tok'${NC}"
                        else
                            echo -e "  ${RED}'$tok' matches ${#matches[@]} projects — use a number${NC}"
                        fi
                    fi
                    ;;
            esac
        done
    done

    LAST_ROOT="$root"
}

if [ -n "$LIST" ]; then
    if [ ! -t 0 ]; then
        echo "--list needs a terminal to pick from. Pass the directories instead:" >&2
        echo "  myjarbis init <dir> <dir> ..." >&2
        exit 1
    fi
    ROOT="${TARGETS[0]:-}"
    [ -n "$ROOT" ] || ROOT="$(default_get last_root)"
    [ -n "$ROOT" ] && [ -d "$ROOT" ] || ROOT="$CURRENT_DIR"
    pick_projects "$ROOT"
    default_set last_root "$LAST_ROOT"

    if [ "${#PICKED[@]}" -eq 0 ]; then
        echo "  nothing selected"
        exit 0
    fi
    echo
    echo -e "  ${BOLD}To initialise${NC}"
    for d in "${PICKED[@]}"; do
        if [ -d "$d/.myjarbis" ] && [ -z "$ASSUME_YES" ]; then
            echo -e "    $(tilde "$d")  ${DIM}already initialised — skipped (--yes reinitialises)${NC}"
        else
            echo -e "    $(tilde "$d")"
        fi
    done
    echo
    read -p "  Go ahead? [Y/n] " -r
    case "$REPLY" in [Nn]*) echo "  cancelled"; exit 0 ;; esac
    TARGETS=("${PICKED[@]}")
fi

# ─── several projects in one run ──────────────────────────────────
# Each project still goes through the very same steps below, in its own
# process, so a batch cannot drift from a single init. What the batch adds is
# asking the language and persona ONCE, up here, and handing the answer down.
if [ "${#TARGETS[@]}" -gt 0 ]; then
    resolve_style
    SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    DONE=(); SKIPPED=(); FAILED=()
    export MYJARBIS_IN_BATCH=1

    if [ -f "$HOME/.claude.json" ]; then
        cp -p "$HOME/.claude.json" "$HOME/.claude.json.bak-$(date +%s)000"
        export MYJARBIS_CLAUDE_JSON_BACKED_UP=1
    fi

    for target in "${TARGETS[@]}"; do
        if [ ! -d "$target" ]; then
            FAILED+=("$target (not a directory)")
            continue
        fi
        dir="$(cd "$target" && pwd)"
        if [ ! -e "$dir/.git" ]; then
            SKIPPED+=("$(tilde "$dir") (not a git repository)")
            continue
        fi
        if [ -d "$dir/.myjarbis" ] && [ -z "$ASSUME_YES" ]; then
            SKIPPED+=("$(tilde "$dir") (already initialised)")
            continue
        fi
        if (cd "$dir" && "$SELF" "${PASSTHROUGH[@]}" --language="$LANG_CHOICE" --persona="$PERSONA_CHOICE" </dev/null); then
            DONE+=("$(tilde "$dir")")
        else
            FAILED+=("$(tilde "$dir")")
        fi
    done

    section "Batch complete"
    echo
    for d in "${DONE[@]}";    do echo -e "  ${BOLD}done${NC}     $d"; done
    for d in "${SKIPPED[@]}"; do echo -e "  ${DIM}skipped  $d${NC}"; done
    for d in "${FAILED[@]}";  do echo -e "  ${RED}failed${NC}   $d"; done
    echo
    echo -e "  ${DIM}language $LANG_CHOICE · persona $PERSONA_CHOICE — then:${NC} myjarbis start"
    echo
    [ "${#FAILED[@]}" -eq 0 ]
    exit $?
fi

echo
echo -e "${RED}${BOLD}MyJarbis${NC} · project setup"
echo
echo -e "  ${BOLD}Project${NC}   $PROJECT_NAME"
echo -e "  ${BOLD}Path${NC}      $CURRENT_DIR"
echo

# ─── reinit guard ─────────────────────────────────────────────────
if [ -d ".myjarbis" ]; then
    echo -e "${RED}WARN${NC}  .myjarbis/ already exists"
    if [ -n "$ASSUME_YES" ]; then
        echo "      --yes given, reinitializing"
    elif [ -t 0 ]; then
        read -p "      Reinitialize and overwrite? (y/n) " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "      Cancelled"
            exit 0
        fi
    else
        echo "      Refusing to reinitialize without a terminal. Pass --yes to confirm."
        exit 1
    fi
fi

# ─── [1/8] framework detect ───────────────────────────────────────
step 1 "Detect framework"
FRAMEWORK="generic"
if [ -f "artisan" ] && [ -f "composer.json" ]; then
    FRAMEWORK="laravel"
    note "Laravel"
elif [ -f "package.json" ]; then
    if grep -q "\"next\"" package.json; then
        FRAMEWORK="nextjs"; note "Next.js"
    elif grep -q "\"react\"" package.json; then
        FRAMEWORK="react"; note "React"
    elif grep -q "\"vue\"" package.json; then
        FRAMEWORK="vue"; note "Vue.js"
    elif grep -q "\"express\"" package.json; then
        FRAMEWORK="express"; note "Express.js"
    else
        note "Node.js (generic)"
    fi
else
    note "generic"
fi

# ─── [2/8] folder structure ───────────────────────────────────────
step 2 "Create .myjarbis structure"
mkdir -p .myjarbis/{bin,context,prompts,config}
mkdir -p .claude/commands
ok

# ─── [3/8] templates ──────────────────────────────────────────────
step 3 "Apply framework template"
if [ "$FRAMEWORK" = "laravel" ]; then
    cp "$INSTALL_DIR/core/prompts/system-laravel.md" .myjarbis/prompts/system.md
elif [ "$FRAMEWORK" = "express" ]; then
    cp "$INSTALL_DIR/core/prompts/system-express.md" .myjarbis/prompts/system.md
else
    cp "$INSTALL_DIR/core/prompts/system-generic.md" .myjarbis/prompts/system.md
fi

# Project structure analysis is delegated to the framework-detect skill
# (Phase 3 of the v0.2 upgrade). The legacy JS analyzers under
# global/core/analyzers/ never existed — we write a placeholder template
# that the agent enriches on the first session.
cat > .myjarbis/context/project-summary.md << EOF
# $PROJECT_NAME - Project Summary

## Overview

Project initialized on $(date +%Y-%m-%d).

**Framework:** $FRAMEWORK

## Project Structure

TODO: Will be enriched by the framework-detect skill on first
Claude session. Run 'claude' from this directory and the agent
will analyze the codebase and update this file.

## Architecture

TODO: Document architecture decisions

## Key Components

TODO: List main components/modules

## Development Notes

- Initialized with MyJarbis on $(date +%Y-%m-%d)
- Framework detected: $FRAMEWORK
EOF

cat > .myjarbis/context/knowledge-base.md << 'EOF'
# Knowledge Base

This file contains a chronological record of everything built in this project.

Each entry documents:
- **What** was implemented
- **Why** decisions were made
- **How** it was implemented
- **Files** that were created/modified

This serves as project memory for Claude and documentation for the team.

---

EOF

cat > .myjarbis/context/daily.md << EOF
# Daily Context - $(date +%Y-%m-%d)

## Today's Focus

TODO: What are we working on today?

## Recent Changes

- Project initialized with MyJarbis

## Current Status

- Framework: $FRAMEWORK
- Ready for development

## Next Steps

1. Review project structure
2. Plan first feature
3. Start implementation

---

Last updated: $(date +%Y-%m-%d)
EOF

cat > .myjarbis/config/settings.json << EOF
{
  "project": {
    "name": "$PROJECT_NAME",
    "framework": "$FRAMEWORK",
    "initialized": "$(date -u +"%Y-%m-%dT%H:%M:%S.000Z")"
  },
  "mcp": { "enabled": true },
  "context": { "autoGenerateCodebase": false, "maxCodebaseSize": "10MB" }
}
EOF

cat > .myjarbis/bin/generate-context.sh << 'EOF'
#!/bin/bash
# Generate codebase.txt — a text dump of the entire codebase.

OUTPUT=".myjarbis/context/codebase.txt"
echo "Generating codebase context..."
echo "# Codebase Context - Generated $(date)" > "$OUTPUT"
echo "" >> "$OUTPUT"

find . -type f \
  -not -path "*/node_modules/*" \
  -not -path "*/vendor/*" \
  -not -path "*/.git/*" \
  -not -path "*/build/*" \
  -not -path "*/dist/*" \
  -not -path "*/.myjarbis/*" \
  -not -name "*.min.js" \
  -not -name "package-lock.json" \
  | while read file; do
    echo "--- $file" >> "$OUTPUT"
    cat "$file" >> "$OUTPUT"
    echo "" >> "$OUTPUT"
done

echo "Generated: $OUTPUT"
EOF
chmod +x .myjarbis/bin/generate-context.sh

cat > .myjarbis/bin/daily.sh << 'EOF'
#!/bin/bash
# Update daily.md with current date.
DAILY_FILE=".myjarbis/context/daily.md"
TODAY=$(date +%Y-%m-%d)
sed -i.bak "1s/.*/# Daily Context - $TODAY/" "$DAILY_FILE"
sed -i.bak "s/Last updated: .*/Last updated: $TODAY/" "$DAILY_FILE"
rm -f "${DAILY_FILE}.bak"
echo "Updated daily.md"
EOF
chmod +x .myjarbis/bin/daily.sh
ok

# ─── [4/8] /jarbis command ────────────────────────────────────────
step 4 "Install /jarbis command"

# Language has to be known BEFORE this step so we can pick the right
# trilingual variant of jarbis.md. Step 8 also needs it (for the
# interaction-style skill); both are resolved once here.
resolve_style
if [ -n "$STYLE_FROM_DEFAULTS" ]; then
    note "language $LANG_CHOICE · persona $PERSONA_CHOICE, from your defaults (--ask to change)"
fi
JARBIS_LANG=$(echo "$LANG_CHOICE" | tr '[:upper:]' '[:lower:]')

# Every slash command ships as <name>.<lang>.md and installs as <name>.md.
# Listed rather than globbed so a half-finished template in the install dir
# cannot become a live command, and so `commands sync` (which propagates
# these to projects that already exist) has the same list to work from.
for cmd in jarbis jarbis-close jarbis-save; do
    CMD_TEMPLATE="$INSTALL_DIR/templates/.claude/commands/${cmd}.${JARBIS_LANG}.md"
    if [ ! -f "$CMD_TEMPLATE" ]; then
        note "${cmd}.${JARBIS_LANG}.md not found, falling back to ES"
        CMD_TEMPLATE="$INSTALL_DIR/templates/.claude/commands/${cmd}.es.md"
    fi
    if [ ! -f "$CMD_TEMPLATE" ]; then
        warn "no template for /${cmd}, skipping"
        continue
    fi
    cp "$CMD_TEMPLATE" ".claude/commands/${cmd}.md"
    note "installed ${cmd}.md ($LANG_CHOICE variant)"
done

# Cleanup stale slash commands from previous MyJarbis versions
STALE_REMOVED=0
for stale in plan implement complete module skill resume import compact; do
    if [ -f ".claude/commands/${stale}.md" ]; then
        rm -f ".claude/commands/${stale}.md"
        STALE_REMOVED=$((STALE_REMOVED + 1))
    fi
done
if [ "$STALE_REMOVED" -gt 0 ]; then
    note "removed $STALE_REMOVED stale command(s) from previous version"
fi
ok

# ─── [5/8] register project ───────────────────────────────────────
step 5 "Register project"
node -e "
const fs = require('fs');
const registryPath = '$REGISTRY_FILE';
let registry = { _version: '1.0', _comment: 'Auto-generated', projects: {} };
if (fs.existsSync(registryPath)) {
    registry = JSON.parse(fs.readFileSync(registryPath, 'utf-8'));
}
registry.projects['$PROJECT_NAME'] = {
    name: '$PROJECT_NAME',
    path: '$CURRENT_DIR',
    framework: '$FRAMEWORK',
    initialized: new Date().toISOString(),
    lastAccessed: new Date().toISOString()
};
registry._lastUpdated = new Date().toISOString();
fs.writeFileSync(registryPath, JSON.stringify(registry, null, 2));
"
ok

# ─── [6/8] plugin (hooks + manifest) ──────────────────────────────
step 6 "Install hooks"
if [ -d "$INSTALL_DIR/templates/.claude-plugin" ]; then
    rm -rf .claude-plugin
    cp -r "$INSTALL_DIR/templates/.claude-plugin" .claude-plugin
    chmod +x .claude-plugin/scripts/*.sh 2>/dev/null || true

    # Copying the scripts is only half the job. Claude Code reads a
    # plugin's hooks.json only for plugins installed from a marketplace,
    # and never auto-discovers a .claude-plugin/ directory in the working
    # tree — so without this the four events stay dead and MyJarbis never
    # greets the user. Declaring them in .claude/settings.local.json is
    # what actually binds them. That file is already gitignored as
    # per-developer state, so nothing lands in the user's commit.
    if node "$INSTALL_DIR/mcp-server/build/cli.js" hook install claude >/dev/null 2>&1; then
        ok
    else
        warn "hook scripts copied, but wiring them into .claude/settings.local.json failed"
        note "run 'myjarbis hook install claude' by hand to finish"
    fi
else
    warn "plugin templates not found at $INSTALL_DIR/templates/.claude-plugin"
fi

# ─── [7/9] Claude auto-memory pointer ─────────────────────────────
step 7 "Provision Claude auto-memory pointer"

CLAUDE_PROJECT_SLUG=$(echo "$CURRENT_DIR" | sed 's|/|-|g')
CLAUDE_MEMORY_DIR="$HOME/.claude/projects/$CLAUDE_PROJECT_SLUG/memory"
TEMPLATE_SRC="$INSTALL_DIR/templates/auto-memory/MEMORY.md"

MEMORY_FILE="$CLAUDE_MEMORY_DIR/MEMORY.md"

if [ -n "$SKIP_MEMORY" ]; then
    note "--skip-memory given, leaving MEMORY.md alone"
elif [ ! -f "$TEMPLATE_SRC" ]; then
    warn "auto-memory template not found at $TEMPLATE_SRC — skipping"
else
    mkdir -p "$CLAUDE_MEMORY_DIR"

    if [ ! -f "$MEMORY_FILE" ] || [ ! -s "$MEMORY_FILE" ]; then
        cp "$TEMPLATE_SRC" "$MEMORY_FILE"
        note "auto-memory pointer written under ~/.claude/projects/<slug>/memory/"
    else
        # MEMORY.md is Claude Code's index of its own memories, and it is
        # shared with whatever session is running right now. Overwriting it
        # destroys that index live, so we only ever append our pointer and
        # leave the existing content as the file's head.
        if grep -q "MyJarbis" "$MEMORY_FILE"; then
            note "auto-memory pointer already present, left as is"
        else
            BACKUP="$MEMORY_FILE.bak.$(date +%s)"
            cp "$MEMORY_FILE" "$BACKUP"
            {
                echo
                cat "$TEMPLATE_SRC"
            } >> "$MEMORY_FILE"
            note "auto-memory pointer appended (backup: $(basename "$BACKUP"))"
        fi
    fi
fi
ok

# ─── [8/9] persona + seed memory.db ───────────────────────────────
step 8 "Configure persona and seed memory.db"

# LANG_CHOICE and PERSONA_CHOICE were both resolved at step 4.
note "language: $LANG_CHOICE"
note "persona:  $PERSONA_CHOICE"

CLI_JS="$INSTALL_DIR/mcp-server/build/cli.js"
if [ -f "$CLI_JS" ]; then
    INIT_ARGS=(init-project
        --name="$PROJECT_NAME" --framework="$FRAMEWORK"
        --language="$LANG_CHOICE" --persona="$PERSONA_CHOICE")
    if [ -n "$ORG_SLUG" ]; then
        INIT_ARGS+=(--org="$ORG_SLUG")
    fi
    if [ -n "$ISOLATION" ]; then
        INIT_ARGS+=(--isolation="$ISOLATION")
    fi
    if [ -n "$PACK_PATH" ]; then
        INIT_ARGS+=(--pack-path="$PACK_PATH")
    fi
    if node "$CLI_JS" "${INIT_ARGS[@]}" >/dev/null; then
        if [ "$ISOLATION" = "shared" ]; then
            note "rows seeded into the shared brain + 10 baseline skills"
        else
            note "memory.db + 10 baseline skills + interaction-style"
        fi
        if [ -n "$ORG_SLUG" ]; then
            note "org pack: $ORG_SLUG"
        fi
        ok
    else
        warn "init-project failed (DB will be created on first session)"
    fi
else
    warn "cli.js not found at $CLI_JS"
fi

# ─── [9/9] update .gitignore + Claude MCP config ──────────────────
step 9 "Update .gitignore and Claude MCP config"

if [ -f ".gitignore" ]; then
    if ! grep -q ".myjarbis/context/codebase.txt" .gitignore; then
        echo "" >> .gitignore
        echo "# MyJarbis" >> .gitignore
        echo ".myjarbis/context/codebase.txt" >> .gitignore
    fi
else
    cat > .gitignore << 'EOF'
# MyJarbis
.myjarbis/context/codebase.txt
EOF
fi

# Configure Claude Code MCP locally for this project.
#
# ~/.claude.json belongs to Claude Code and holds far more than our entry —
# including the other MCP servers this project already uses. This step used
# to assign the whole `mcpServers` object, which silently unregistered every
# one of them. It now adds `myjarbis` next to whatever is there, backs the
# file up first (same `.bak-<ms>` naming as `gc`), refuses to touch a file it
# cannot parse, and swaps the new content in atomically so a Claude Code
# process reading it never sees half a file.
if python3 << 'PYTHON_EOF' >/dev/null
import json
import os
import shutil
import sys
import tempfile
import time

claude_config = os.path.expanduser('~/.claude.json')
data = {}

if os.path.exists(claude_config):
    try:
        with open(claude_config, 'r') as f:
            data = json.load(f)
    except ValueError as e:
        print(f'~/.claude.json is not valid JSON ({e}), left untouched', file=sys.stderr)
        sys.exit(1)
    # A batch backs the file up once, before its first project, rather than
    # leaving one copy of a file this size per project.
    if not os.environ.get('MYJARBIS_CLAUDE_JSON_BACKED_UP'):
        shutil.copy2(claude_config, f'{claude_config}.bak-{int(time.time() * 1000)}')

entry = data.setdefault('projects', {}).setdefault(os.getcwd(), {})
servers = entry.get('mcpServers') or {}
servers['myjarbis'] = {
    'type': 'stdio',
    'command': 'node',
    'args': [os.path.expanduser('~/.myjarbis-global/mcp-server/build/index.js')],
    'env': {}
}
entry['mcpServers'] = servers

fd, tmp = tempfile.mkstemp(dir=os.path.dirname(claude_config), prefix='.claude.json.')
with os.fdopen(fd, 'w') as f:
    json.dump(data, f, indent=2)
if os.path.exists(claude_config):
    shutil.copymode(claude_config, tmp)
os.replace(tmp, claude_config)
PYTHON_EOF
then
    ok
else
    warn "could not register the MCP server in ~/.claude.json"
    note "add it by hand: claude mcp add myjarbis node ~/.myjarbis-global/mcp-server/build/index.js"
fi

# ─── done ─────────────────────────────────────────────────────────
section "Setup complete"
echo
echo -e "  ${BOLD}Project${NC}    $PROJECT_NAME"
echo -e "  ${BOLD}Framework${NC}  $FRAMEWORK"
echo -e "  ${BOLD}Language${NC}   $LANG_CHOICE"
echo -e "  ${BOLD}Persona${NC}    $PERSONA_CHOICE"
echo -e "  ${BOLD}Skills${NC}     10 baselines materialized in .claude/skills/"
echo
# Inside a batch the summary says what comes next, once.
[ -z "${MYJARBIS_IN_BATCH:-}" ] || exit 0
section "Next"
echo
echo -e "  ${RED}\$${NC} claude"
echo -e "  ${RED}>${NC} /jarbis          ${DIM}open the session${NC}"
echo -e "  ${RED}>${NC} /jarbis-close    ${DIM}when you stop, so the next one resumes here${NC}"
echo
