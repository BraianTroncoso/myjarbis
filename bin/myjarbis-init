#!/bin/bash

#
# MyJarbis Project Initialization Script
#
# This script initializes MyJarbis in the current project:
# 1. Creates .myjarbis/ folder structure
# 2. Copies templates (prompts, config, scripts)
# 3. Detects project framework
# 4. Generates project summary
# 5. Registers project in global registry
# 6. Updates .gitignore
#

set -e

# Colors - Iron Man theme (red and gold)
RED='\033[1;31m'      # Bright red (Iron Man red)
GOLD='\033[1;33m'     # Bright yellow/gold (Iron Man gold)
GREEN='\033[0;32m'    # Keep green for success
YELLOW='\033[1;33m'   # Warning yellow
NC='\033[0m'          # No Color

# Paths
INSTALL_DIR="${MYJARBIS_INSTALL_DIR:-$HOME/.myjarbis-global}"
TEMPLATES_DIR="$INSTALL_DIR/templates"
REGISTRY_FILE="$INSTALL_DIR/projects-registry.json"
CURRENT_DIR="$(pwd)"
PROJECT_NAME="$(basename "$CURRENT_DIR")"

echo ""
echo -e "${RED}╔════════════════════════════════════════════════╗${NC}"
echo -e "${RED}║${GOLD}         🤖 JARBIS PROJECT SETUP             ${RED}║${NC}"
echo -e "${RED}╚════════════════════════════════════════════════╝${NC}"
echo ""
echo -e "${GOLD}Project:${NC} $PROJECT_NAME"
echo -e "${GOLD}Path:${NC}    $CURRENT_DIR"
echo ""

# Check if already initialized
if [ -d ".myjarbis" ]; then
    echo -e "${YELLOW}Warning: .myjarbis/ folder already exists${NC}"
    read -p "Reinitialize? This will overwrite existing files (y/n) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Initialization cancelled"
        exit 0
    fi
fi

# Detect framework
echo -e "${GOLD}[1/6]${NC} Detecting project framework..."
FRAMEWORK="generic"

if [ -f "artisan" ] && [ -f "composer.json" ]; then
    FRAMEWORK="laravel"
    echo -e "${GREEN}✓${NC} Detected: Laravel"
elif [ -f "package.json" ]; then
    if grep -q "\"next\"" package.json; then
        FRAMEWORK="nextjs"
        echo -e "${GREEN}✓${NC} Detected: Next.js"
    elif grep -q "\"react\"" package.json; then
        FRAMEWORK="react"
        echo -e "${GREEN}✓${NC} Detected: React"
    elif grep -q "\"vue\"" package.json; then
        FRAMEWORK="vue"
        echo -e "${GREEN}✓${NC} Detected: Vue.js"
    elif grep -q "\"express\"" package.json; then
        FRAMEWORK="express"
        echo -e "${GREEN}✓${NC} Detected: Express.js"
    else
        echo -e "${YELLOW}!${NC} Detected: Node.js (generic)"
    fi
else
    echo -e "${YELLOW}!${NC} Framework: Generic"
fi

# Create .myjarbis folder structure
echo ""
echo -e "${GOLD}[2/6]${NC} Creating .myjarbis folder structure..."
mkdir -p .myjarbis/{bin,context,prompts,config}
mkdir -p .claude/commands
echo -e "${GREEN}✓${NC} Created folder structure"

# Run analyzer and copy templates
echo ""
echo -e "${GOLD}[3/6]${NC} Analyzing project and setting up templates..."

# Copy framework-specific system.md
if [ "$FRAMEWORK" = "laravel" ]; then
    cp "$INSTALL_DIR/core/prompts/system-laravel.md" .myjarbis/prompts/system.md
elif [ "$FRAMEWORK" = "express" ]; then
    cp "$INSTALL_DIR/core/prompts/system-express.md" .myjarbis/prompts/system.md
else
    cp "$INSTALL_DIR/core/prompts/system-generic.md" .myjarbis/prompts/system.md
fi

# Project structure analysis is delegated to Claude via the
# 'framework-detect' skill (Phase 3 of the v0.2 upgrade). The legacy
# JS analyzers under global/core/analyzers/ never existed — calls
# silently fell back to a template, masking the bug. We now write
# the template directly and let the agent enrich it on first session.
cat > .myjarbis/context/project-summary.md << EOF
# $PROJECT_NAME - Project Summary

## Overview

Project initialized on $(date +%Y-%m-%d).

**Framework:** $FRAMEWORK

## Project Structure

TODO: Will be enriched by the framework-detect skill on first
Claude session. Run 'claude' from this directory and the agent
will analyze the codebase and update this file.

## Architecture

TODO: Document architecture decisions

## Key Components

TODO: List main components/modules

## Development Notes

- Initialized with MyJarbis on $(date +%Y-%m-%d)
- Framework detected: $FRAMEWORK
EOF

# knowledge-base.md (context)
cat > .myjarbis/context/knowledge-base.md << 'EOF'
# Knowledge Base

This file contains a chronological record of everything built in this project.

Each entry documents:
- **What** was implemented
- **Why** decisions were made
- **How** it was implemented
- **Files** that were created/modified

This serves as project memory for Claude and documentation for the team.

---

EOF

# daily.md (context)
cat > .myjarbis/context/daily.md << EOF
# Daily Context - $(date +%Y-%m-%d)

## Today's Focus

TODO: What are we working on today?

## Recent Changes

- Project initialized with MyJarbis

## Current Status

- Framework: $FRAMEWORK
- Ready for development

## Next Steps

1. Review project structure
2. Plan first feature
3. Start implementation

---

Last updated: $(date +%Y-%m-%d)
EOF

# settings.json (config)
cat > .myjarbis/config/settings.json << EOF
{
  "project": {
    "name": "$PROJECT_NAME",
    "framework": "$FRAMEWORK",
    "initialized": "$(date -u +"%Y-%m-%dT%H:%M:%S.000Z")"
  },
  "mcp": {
    "enabled": true
  },
  "context": {
    "autoGenerateCodebase": false,
    "maxCodebaseSize": "10MB"
  }
}
EOF

# generate-context.sh (bin)
cat > .myjarbis/bin/generate-context.sh << 'EOF'
#!/bin/bash
# Generate codebase.txt - a text dump of the entire codebase
# Useful for giving Claude full project context

OUTPUT=".myjarbis/context/codebase.txt"

echo "Generating codebase context..."
echo "# Codebase Context - Generated $(date)" > "$OUTPUT"
echo "" >> "$OUTPUT"

# Find all relevant files (exclude node_modules, vendor, etc.)
find . -type f \
  -not -path "*/node_modules/*" \
  -not -path "*/vendor/*" \
  -not -path "*/.git/*" \
  -not -path "*/build/*" \
  -not -path "*/dist/*" \
  -not -path "*/.myjarbis/*" \
  -not -name "*.min.js" \
  -not -name "package-lock.json" \
  | while read file; do
    echo "━━━ $file" >> "$OUTPUT"
    cat "$file" >> "$OUTPUT"
    echo "" >> "$OUTPUT"
    echo "" >> "$OUTPUT"
done

echo "✓ Generated: $OUTPUT"
EOF
chmod +x .myjarbis/bin/generate-context.sh

# daily.sh (bin)
cat > .myjarbis/bin/daily.sh << 'EOF'
#!/bin/bash
# Update daily.md with current date

DAILY_FILE=".myjarbis/context/daily.md"
TODAY=$(date +%Y-%m-%d)

# Update header
sed -i.bak "1s/.*/# Daily Context - $TODAY/" "$DAILY_FILE"
sed -i.bak "s/Last updated: .*/Last updated: $TODAY/" "$DAILY_FILE"
rm -f "${DAILY_FILE}.bak"

echo "✓ Updated daily.md"
EOF
chmod +x .myjarbis/bin/daily.sh

echo -e "${GREEN}✓${NC} Created initial files"

# Create .claude commands from templates
echo ""
echo -e "${GOLD}[4/6]${NC} Creating Claude commands..."

# Copy improved command templates
cp "$INSTALL_DIR/templates/.claude/commands/jarbis.md" .claude/commands/jarbis.md
cp "$INSTALL_DIR/templates/.claude/commands/plan.md" .claude/commands/plan.md
cp "$INSTALL_DIR/templates/.claude/commands/implement.md" .claude/commands/implement.md
cp "$INSTALL_DIR/templates/.claude/commands/complete.md" .claude/commands/complete.md

echo -e "${GREEN}✓${NC} Created command files (including /jarbis)"

# Register project in global registry
echo ""
echo -e "${GOLD}[5/6]${NC} Registering project..."

node -e "
const fs = require('fs');
const registryPath = '$REGISTRY_FILE';

let registry = { _version: '1.0', _comment: 'Auto-generated', projects: {} };

if (fs.existsSync(registryPath)) {
    registry = JSON.parse(fs.readFileSync(registryPath, 'utf-8'));
}

registry.projects['$PROJECT_NAME'] = {
    name: '$PROJECT_NAME',
    path: '$CURRENT_DIR',
    framework: '$FRAMEWORK',
    initialized: new Date().toISOString(),
    lastAccessed: new Date().toISOString()
};

registry._lastUpdated = new Date().toISOString();

fs.writeFileSync(registryPath, JSON.stringify(registry, null, 2));
"

echo -e "${GREEN}✓${NC} Project registered in global registry"

# v0.2: copy plugin manifest + hooks + scripts to project's .claude-plugin/
echo ""
echo -e "${GOLD}[5b/6]${NC} Installing .claude-plugin (hooks + manifest)..."
if [ -d "$INSTALL_DIR/templates/.claude-plugin" ]; then
    rm -rf .claude-plugin
    cp -r "$INSTALL_DIR/templates/.claude-plugin" .claude-plugin
    chmod +x .claude-plugin/scripts/*.sh 2>/dev/null || true
    echo -e "${GREEN}✓${NC} Hooks installed at .claude-plugin/"
else
    echo -e "${YELLOW}!${NC} Plugin templates not found at $INSTALL_DIR/templates/.claude-plugin"
fi

# v0.2: seed memory.db + baseline skills + write v0.2 settings.json
echo ""
echo -e "${GOLD}[5c/6]${NC} Seeding memory.db (v0.2)..."
CLI_JS="$INSTALL_DIR/mcp-server/build/cli.js"
if [ -f "$CLI_JS" ]; then
    node "$CLI_JS" init-project --name="$PROJECT_NAME" --framework="$FRAMEWORK" >/dev/null && \
        echo -e "${GREEN}✓${NC} memory.db created + 6 baseline skills seeded + skills materialized" || \
        echo -e "${YELLOW}!${NC} init-project failed (continuing — DB will be created on first session)"
else
    echo -e "${YELLOW}!${NC} cli.js not found at $CLI_JS — DB will be created on first MCP server start"
fi

# Update .gitignore
echo ""
echo -e "${GOLD}[6/6]${NC} Updating .gitignore..."

if [ -f ".gitignore" ]; then
    if ! grep -q ".myjarbis/context/codebase.txt" .gitignore; then
        echo "" >> .gitignore
        echo "# MyJarbis" >> .gitignore
        echo ".myjarbis/context/codebase.txt" >> .gitignore
        echo -e "${GREEN}✓${NC} Updated .gitignore"
    else
        echo -e "${YELLOW}!${NC} .gitignore already configured"
    fi
else
    cat > .gitignore << 'EOF'
# MyJarbis
.myjarbis/context/codebase.txt
EOF
    echo -e "${GREEN}✓${NC} Created .gitignore"
fi

# Success
echo ""
echo -e "${RED}╔════════════════════════════════════════════════╗${NC}"
echo -e "${RED}║${GREEN}       ✓ JARBIS ONLINE - READY TO ASSIST     ${RED}║${NC}"
echo -e "${RED}╚════════════════════════════════════════════════╝${NC}"
echo ""
echo -e "${GOLD}Project:${NC}    $PROJECT_NAME"
echo -e "${GOLD}Framework:${NC}  $FRAMEWORK"
echo -e "${GOLD}Structure:${NC}  .myjarbis/ + .claude/ configured"
echo ""
echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GOLD}[ BOOT SEQUENCE ]${NC}"
echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo -e "${GOLD}1. ACTIVATE JARBIS${NC}"
echo -e "   \$ claude"
echo -e "   > ${GOLD}/jarbis${NC}  ${NC}← Loads project context + MCP tools${NC}"
echo ""
echo -e "${GOLD}2. WORKFLOW COMMANDS${NC}"
echo ""
echo -e "   ${GOLD}/plan${NC}       ${NC}Break down features, ask questions, strategize${NC}"
echo -e "   ${GOLD}/implement${NC}  ${NC}Execute current phase with laser focus${NC}"
echo -e "   ${GOLD}/complete${NC}   ${NC}Archive work, update knowledge base${NC}"
echo ""
echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GOLD}[ MCP INTELLIGENCE LAYER ]${NC}"
echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo -e "  ${GOLD}search_code${NC}     ${NC}Intelligent codebase search${NC}"
echo -e "                  ${NC}When: \"Where's the auth logic?\"${NC}"
echo ""
echo -e "  ${GOLD}get_context${NC}     ${NC}Curated context retrieval${NC}"
echo -e "                  ${NC}When: \"Explain the payment flow\"${NC}"
echo ""
echo -e "  ${GOLD}update_memory${NC}   ${NC}Persistent knowledge storage${NC}"
echo -e "                  ${NC}When: Auto-called by /complete${NC}"
echo ""
echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GOLD}[ OPERATIONAL NOTES ]${NC}"
echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo -e "  Run ${GOLD}/jarbis${NC} every new Claude session"
echo -e "  MCP tools activate automatically when Claude needs them"
echo -e "  Use ${GOLD}myjarbis context${NC} to refresh project analysis"
echo -e "  Knowledge base builds over time in ${GOLD}.myjarbis/context/${NC}"
echo ""
echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GOLD}[ RECOMMENDED FIRST ACTION ]${NC}"
echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo -e "  \$ ${GREEN}claude${NC}"
echo -e "  > ${GOLD}/jarbis${NC}"
echo -e "  > ${GOLD}/plan${NC} \"Add user registration feature\""
echo ""
echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo -e "${NC}Built by Braian Troncoso  |  Run ${GOLD}myjarbis help${NC} for more info${NC}"
echo ""

# Configure Claude Code to use global MCP servers
echo ""
echo -e "${GOLD}[7/7]${NC} Configuring Claude Code MCP servers..."

# Use Python to safely update .claude.json
# Use Python to safely update .claude.json
python3 << 'PYTHON_EOF'
import json
import os

claude_config = os.path.expanduser('~/.claude.json')

# Load existing config
if os.path.exists(claude_config):
    with open(claude_config, 'r') as f:
        data = json.load(f)
else:
    data = {'projects': {}}

# Ensure projects key exists
if 'projects' not in data:
    data['projects'] = {}

# Get current project path
project_path = os.getcwd()

# Ensure project entry exists
if project_path not in data['projects']:
    data['projects'][project_path] = {}

# Configure MCP server LOCALLY for this project
mcp_server_path = os.path.expanduser('~/.myjarbis-global/mcp-server/build/index.js')
data['projects'][project_path]['mcpServers'] = {
    'myjarbis': {
        'type': 'stdio',
        'command': 'node',
        'args': [mcp_server_path],
        'env': {}
    }
}

# Save config
with open(claude_config, 'w') as f:
    json.dump(data, f, indent=2)

print("✓ Configured MCP server locally for this project")
PYTHON_EOF

echo -e "${GREEN}✓${NC} Claude Code configured to use global MCP servers"

