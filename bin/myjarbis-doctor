#!/bin/bash
#
# MyJarbis Doctor — Diagnostic Tool
#
# Verifies the entire MyJarbis installation and configuration.
# Continues even when checks fail (no `set -e`).
#

# Minimal palette: blood red as the only accent, bold + dim for hierarchy.
RED='\033[38;5;88m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# Paths
INSTALL_DIR="${MYJARBIS_INSTALL_DIR:-$HOME/.myjarbis-global}"
REGISTRY_FILE="$INSTALL_DIR/projects-registry.json"
CURRENT_DIR="$(pwd)"
CLAUDE_CONFIG="$HOME/.claude.json"

# Is the current directory a project? Having a .myjarbis/ is not enough:
# MYJARBIS_HOME is ~/.myjarbis, so run from $HOME the shared-brain dir reads
# as a project's, and every check below reports on it — "settings.json
# missing" as a FAIL, on a directory that was never meant to have one.
# `myjarbis setup` runs this doctor, and with npm it is run from anywhere,
# $HOME first of all. Compare physical paths, not strings.
MYJARBIS_HOME_DIR="${MYJARBIS_HOME:-$HOME/.myjarbis}"
IN_PROJECT=""
IS_MYJARBIS_HOME=""
if [ -d ".myjarbis" ]; then
    if [ -d "$MYJARBIS_HOME_DIR" ] && \
       [ "$(cd -P .myjarbis && pwd)" = "$(cd -P "$MYJARBIS_HOME_DIR" && pwd)" ]; then
        IS_MYJARBIS_HOME=1
    else
        IN_PROJECT=1
    fi
fi

CHECKS_PASSED=0
CHECKS_FAILED=0
WARNINGS=0

section() { echo; echo -e "${RED}${BOLD}$1${NC}"; }
pass()    { echo -e "  OK    $1"; ((CHECKS_PASSED++)); }
fail()    { echo -e "  ${RED}${BOLD}FAIL${NC}  $1"; ((CHECKS_FAILED++)); }
warn()    { echo -e "  ${RED}WARN${NC}  $1"; ((WARNINGS++)); }
note()    { echo -e "        ${DIM}$1${NC}"; }

echo
echo -e "${RED}${BOLD}MyJarbis${NC} · health check"

# ─── installation ─────────────────────────────────────────────────
section "Installation"

if [ -d "$INSTALL_DIR" ]; then
    pass "installed at $INSTALL_DIR"
else
    fail "not found at $INSTALL_DIR"
    note "run the install script"
fi

if [ -f "$INSTALL_DIR/bin/myjarbis" ]; then
    pass "CLI at $INSTALL_DIR/bin/myjarbis"
elif [ -f "$INSTALL_DIR/../bin/myjarbis" ]; then
    pass "CLI at $INSTALL_DIR/../bin/myjarbis (dev layout)"
elif command -v myjarbis &> /dev/null; then
    pass "CLI on PATH ($(command -v myjarbis))"
else
    fail "CLI not found"
fi

if [ -f "$INSTALL_DIR/mcp-server/build/index.js" ]; then
    pass "MCP server build present"
else
    fail "MCP server build not found"
fi

if command -v myjarbis &> /dev/null; then
    pass "myjarbis on PATH"
else
    warn "myjarbis not on PATH"
    note "npm i -g myjarbis, or add ~/.myjarbis-global/bin to PATH"
fi

# Where the code came from, written by `myjarbis setup`. Installs from
# before it have no .channel and are git installs.
CHANNEL="$(cat "$INSTALL_DIR/.channel" 2>/dev/null || echo git)"
RUNTIME_VERSION="$(cat "$INSTALL_DIR/.version" 2>/dev/null || true)"
SOURCE_DIR="$(cat "$INSTALL_DIR/.source" 2>/dev/null || true)"
if [ "$CHANNEL" = "npm" ]; then
    PKG_VERSION="$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$SOURCE_DIR/package.json" 2>/dev/null | head -1)"
    if [ -z "$PKG_VERSION" ]; then
        warn "installed from npm, but the package is gone from $SOURCE_DIR"
        note "reinstall it: npm i -g myjarbis && myjarbis setup"
    elif [ "$PKG_VERSION" != "$RUNTIME_VERSION" ]; then
        warn "package is v$PKG_VERSION, runtime is v${RUNTIME_VERSION:-?}"
        note "run: myjarbis setup"
    else
        pass "installed from npm · v$RUNTIME_VERSION"
    fi

    # Harmless — it points at the same runtime — but it shadows npm's link,
    # and the dispatcher in the runtime cannot tell the package is newer.
    for rc in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile"; do
        if [ -f "$rc" ] && grep -q "myjarbis-global/bin" "$rc" 2>/dev/null; then
            warn "$rc still adds ~/.myjarbis-global/bin to PATH"
            note "left from a git install; npm already puts myjarbis on PATH."
            note "remove the '# MyJarbis CLI' line from it"
        fi
    done
else
    pass "installed from a checkout${SOURCE_DIR:+ ($SOURCE_DIR)}${RUNTIME_VERSION:+ · v$RUNTIME_VERSION}"
fi

# better-sqlite3 is native, built for one Node ABI. With nvm, the node that
# ran setup and the node Claude Code spawns the server with can differ, and
# then the server dies at its first query with NODE_MODULE_VERSION mismatch.
SQLITE_MOD="$INSTALL_DIR/mcp-server/node_modules/better-sqlite3"
if [ -d "$SQLITE_MOD" ]; then
    if ABI_ERR="$(node -e "const D=require('$SQLITE_MOD'); new D(':memory:').close()" 2>&1)"; then
        pass "native SQLite module loads under node $(node --version)"
    else
        fail "native SQLite module does not load under node $(node --version)"
        echo "$ABI_ERR" | grep -m1 -E "NODE_MODULE_VERSION|Error" | sed 's/^/        /'
        note "rebuild it under the node Claude Code uses:"
        note "  cd $INSTALL_DIR/mcp-server && npm rebuild better-sqlite3"
    fi
fi

# ─── Claude Code integration ──────────────────────────────────────
section "Claude Code integration"

if command -v claude &> /dev/null; then
    pass "Claude Code CLI installed"
    note "version: $(claude --version 2>&1 || echo unknown)"
else
    fail "Claude Code CLI not found"
    note "install from https://docs.claude.com/claude-code"
fi

if [ -f "$CLAUDE_CONFIG" ]; then
    pass "Claude config exists (~/.claude.json)"
    if grep -q "myjarbis" "$CLAUDE_CONFIG" 2>/dev/null; then
        pass "MCP server registered in Claude config"
    else
        warn "MCP server not registered (run myjarbis init in a project)"
    fi
else
    warn "Claude config not found"
fi

if [ -f "$INSTALL_DIR/mcp-server/build/index.js" ]; then
    if timeout 2 node "$INSTALL_DIR/mcp-server/build/index.js" \
        <<< '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"test","version":"1.0"}}}' &> /dev/null; then
        pass "MCP server responding"
    else
        warn "MCP server may have issues (normal if no projects registered)"
    fi
fi

# ─── current project ──────────────────────────────────────────────
section "Current project"

if [ -n "$IN_PROJECT" ]; then
    pass ".myjarbis/ exists"

    if [ -f ".myjarbis/config/settings.json" ]; then
        pass "settings.json present"
        PROJECT_NAME=$(grep -o '"name"[[:space:]]*:[[:space:]]*"[^"]*"' .myjarbis/config/settings.json | cut -d'"' -f4)
        FRAMEWORK=$(grep -o '"framework"[[:space:]]*:[[:space:]]*"[^"]*"' .myjarbis/config/settings.json | cut -d'"' -f4)
        note "project: $PROJECT_NAME ($FRAMEWORK)"
    else
        fail "settings.json missing"
    fi

    REQUIRED_FILES=(
        ".myjarbis/context/project-summary.md"
        ".myjarbis/context/knowledge-base.md"
        ".myjarbis/context/daily.md"
        ".myjarbis/prompts/system.md"
        ".claude/commands/jarbis.md"
    )
    for file in "${REQUIRED_FILES[@]}"; do
        if [ -f "$file" ]; then
            pass "$(basename $file)"
        else
            warn "$(basename $file) missing"
        fi
    done

    if [ -f "$REGISTRY_FILE" ] && [ -n "$PROJECT_NAME" ]; then
        if grep -q "\"$PROJECT_NAME\"" "$REGISTRY_FILE"; then
            pass "registered in global registry"
        else
            warn "not registered in global registry"
        fi
    fi

    CLI_JS="$INSTALL_DIR/mcp-server/build/cli.js"

    # Ask resolution where this project's brain is, rather than assuming a
    # silo. A project with isolation = shared has no .myjarbis/memory.db at
    # all, and the old `-f` gate reported it as "memory.db missing — run
    # myjarbis init", then skipped every check below. Resolution also never
    # creates a file, which `MyJarbisDB.open()` did.
    if [ -f "$CLI_JS" ]; then
        BRAIN_INFO=$(node --input-type=module -e "
            import { resolveProject } from '$INSTALL_DIR/mcp-server/build/resolve.js';
            import { SCHEMA_VERSION } from '$INSTALL_DIR/mcp-server/build/db/schema.js';
            const r = resolveProject({ cwd: '$CURRENT_DIR' });
            if (!r) { console.log('NONE'); process.exit(0); }
            const have = r.db.meta.get('schema_version');
            console.log(['FOUND', r.db.dbPath, r.project.isolation, have, SCHEMA_VERSION].join('\t'));
            r.db.close();
        " 2>/dev/null || echo "ERR")

        IFS=$'\t' read -r B_STATUS B_PATH B_ISO B_HAVE B_WANT <<< "$BRAIN_INFO"
        case "${B_STATUS:-ERR}" in
            FOUND)
                pass "brain found ($B_ISO): $B_PATH"
                if [ "$B_HAVE" = "$B_WANT" ]; then
                    pass "schema version $B_HAVE"
                else
                    warn "schema version $B_HAVE (expected $B_WANT) — run myjarbis migrate"
                fi
                ;;
            NONE)
                warn "no brain holds this project — run myjarbis init to seed"
                ;;
            *)
                warn "could not resolve this project's brain"
                ;;
        esac
    fi

    if [ -f ".claude-plugin/plugin.json" ]; then
        pass "plugin.json"
    else
        warn ".claude-plugin/plugin.json missing"
    fi

    HOOK_SCRIPTS=(session-start.sh user-prompt-submit.sh post-compaction.sh session-stop.sh session-end.sh)
    HOOKS_OK=true
    for s in "${HOOK_SCRIPTS[@]}"; do
        if [ ! -x ".claude-plugin/scripts/$s" ]; then
            HOOKS_OK=false
            warn "hook not executable: .claude-plugin/scripts/$s"
        fi
    done
    if [ "$HOOKS_OK" = "true" ]; then
        pass "${#HOOK_SCRIPTS[@]} hook scripts present and executable"
    fi

    # The scripts being on disk says nothing about whether Claude Code
    # runs them. This check used to stop at "hooks.json exists", which
    # passed green for months while all four events were dead: Claude
    # Code only reads a plugin's hooks.json for marketplace-installed
    # plugins, never for a .claude-plugin/ directory in the working tree.
    # What binds them is the hooks block in .claude/settings.local.json,
    # so that is what we verify.
    #
    # Three outcomes, not two. `--check` exits 2 when the hooks ARE bound but
    # with an older shape than this version writes — a matcher added since,
    # a renamed script. Reporting that as "NOT wired — Claude Code will never
    # run them" was false and the wrong size of alarm: the hooks fire, they are
    # simply a release behind. The repair is the same command; what differs is
    # whether anything is broken right now.
    if [ -f "$INSTALL_DIR/mcp-server/build/cli.js" ]; then
        node "$INSTALL_DIR/mcp-server/build/cli.js" hook install claude --check >/dev/null 2>&1
        case "$?" in
            0)
                pass "hooks wired into .claude/settings.local.json"
                ;;
            2)
                warn "hooks wired, but not the way this version writes them"
                note "they do fire; re-wire to pick up the current bindings"
                note "fix: myjarbis hook install claude   (then reopen Claude)"
                ;;
            *)
                warn "hook scripts present but NOT wired — Claude Code will never run them"
                note "fix: myjarbis hook install claude   (then reopen Claude)"
                ;;
        esac
    fi

    if [ -d ".claude/skills" ]; then
        SKILL_COUNT=$(find .claude/skills -mindepth 1 -maxdepth 1 -type d -name 'myjarbis-*' 2>/dev/null | wc -l)
        if [ "$SKILL_COUNT" -gt 0 ]; then
            pass "$SKILL_COUNT myjarbis-* skill(s) materialized"
        else
            warn "no materialized skills (expected ≥10 baselines)"
        fi
    else
        warn ".claude/skills/ missing — run myjarbis skill materialize"
    fi
else
    if [ -n "$IS_MYJARBIS_HOME" ]; then
        note "here, .myjarbis/ is MYJARBIS_HOME (the shared brain), not a project"
        note "project checks skipped; run doctor inside a project to see them"
    else
        warn "not in a MyJarbis project (.myjarbis/ not found)"
        note "run myjarbis init to initialize this project"
    fi
fi

# ─── MCP tools roundtrip ──────────────────────────────────────────
section "MCP tools"

if [ -n "$IN_PROJECT" ] && [ -f "$INSTALL_DIR/mcp-server/build/cli.js" ]; then
    # Same reason as above: resolve rather than assume a silo, so a shared
    # project is exercised instead of silently skipped.
    ROUNDTRIP=$(node --input-type=module -e "
        import { resolveProject } from '$INSTALL_DIR/mcp-server/build/resolve.js';
        const r = resolveProject({ cwd: '$CURRENT_DIR' });
        if (!r) { console.log('NO_PROJECT'); process.exit(0); }
        const { db, project } = r;
        // Listing rows requires a bound tenant scope.
        db.bindScope({ kind: 'project', id: project.id });
        const modules = db.modules.listByProject(project.id);
        const skills = db.skills.listByProject(project.id);
        console.log('OK', project.name, modules.length, skills.length);
        db.close();
    " 2>&1)
    case "$ROUNDTRIP" in
        OK\ *)
            pass "DB roundtrip ($ROUNDTRIP)"
            ;;
        NO_PROJECT)
            warn "no brain holds this project — re-run myjarbis init"
            ;;
        *)
            fail "DB roundtrip failed: $ROUNDTRIP"
            ;;
    esac

    note "available tools:"
    note "  current_project, list_modules, create_module"
    note "  start_session, end_session, resume"
    note "  load_project_core, load_module, search, save_observation"
    note "  list_skills, add_skill, materialize_skills"
    note "  import_md, import_json"
    note "  legacy: search_code, get_context, update_memory"
else
    warn "skipped (not in a project or memory.db missing)"
fi

# ─── environment ──────────────────────────────────────────────────
section "Environment"

if [ -n "$IN_PROJECT" ]; then
    FILE_COUNT=$(find . -type f \
        -not -path "*/node_modules/*" \
        -not -path "*/vendor/*" \
        -not -path "*/.git/*" \
        -not -path "*/build/*" \
        -not -path "*/dist/*" \
        2>/dev/null | wc -l)

    if [ "$FILE_COUNT" -gt 10000 ]; then
        warn "large project ($FILE_COUNT files) — searches may be slow"
        note "consider tightening .gitignore"
    else
        pass "project size reasonable ($FILE_COUNT files)"
    fi
fi

if command -v node &> /dev/null; then
    pass "Node.js $(node --version)"
else
    fail "Node.js not found (required for MCP server)"
fi

if [ -d "$HOME/.myjarvis-global" ]; then
    warn "old installation at ~/.myjarvis-global"
    note "remove with: rm -rf ~/.myjarvis-global"
fi

# ─── summary ──────────────────────────────────────────────────────
section "Summary"
echo
if [ $CHECKS_FAILED -eq 0 ] && [ $WARNINGS -eq 0 ]; then
    echo -e "  ${BOLD}all checks passed${NC}"
elif [ $CHECKS_FAILED -eq 0 ]; then
    echo -e "  ${BOLD}passed with warnings${NC}"
else
    echo -e "  ${RED}${BOLD}issues detected${NC}"
fi
echo
echo -e "  passed     ${BOLD}$CHECKS_PASSED${NC}"
echo -e "  failed     ${RED}${BOLD}$CHECKS_FAILED${NC}"
echo -e "  warnings   ${BOLD}$WARNINGS${NC}"
echo

if [ $CHECKS_FAILED -gt 0 ]; then
    echo -e "${RED}${BOLD}Next${NC}"
    echo
    echo "  1. review failed checks above"
    echo "  2. myjarbis help"
    echo "  3. https://github.com/braiantroncoso/myjarbis"
    echo
    exit 1
fi

exit 0
