#!/bin/bash

#
# MyJarbis Doctor - Diagnostic Tool
#
# Verifies the entire MyJarbis installation and configuration
#

# Note: Not using set -e because we want to continue even if checks fail

# Colors
RED='\033[1;31m'
GOLD='\033[1;33m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Paths
INSTALL_DIR="${MYJARBIS_INSTALL_DIR:-$HOME/.myjarbis-global}"
REGISTRY_FILE="$INSTALL_DIR/projects-registry.json"
CURRENT_DIR="$(pwd)"
CLAUDE_CONFIG="$HOME/.claude.json"

# Check counters
CHECKS_PASSED=0
CHECKS_FAILED=0
WARNINGS=0

echo ""
echo -e "${RED}╔════════════════════════════════════════════════╗${NC}"
echo -e "${RED}║${GOLD}          🔧 JARBIS HEALTH CHECK              ${RED}║${NC}"
echo -e "${RED}╚════════════════════════════════════════════════╝${NC}"
echo ""

# Helper functions
check_pass() {
    echo -e "${GREEN}✓${NC} $1"
    ((CHECKS_PASSED++))
}

check_fail() {
    echo -e "${RED}✗${NC} $1"
    ((CHECKS_FAILED++))
}

check_warn() {
    echo -e "${YELLOW}!${NC} $1"
    ((WARNINGS++))
}

# [1/5] Check MyJarbis installation
echo -e "${GOLD}[1/5]${NC} Checking MyJarbis installation..."
echo ""

if [ -d "$INSTALL_DIR" ]; then
    check_pass "MyJarbis installed at $INSTALL_DIR"
else
    check_fail "MyJarbis not found at $INSTALL_DIR"
    echo -e "       ${YELLOW}Run the install script to install MyJarbis${NC}"
fi

if [ -f "$INSTALL_DIR/bin/myjarbis" ]; then
    check_pass "CLI tool available at $INSTALL_DIR/bin/myjarbis"
elif [ -f "$INSTALL_DIR/../bin/myjarbis" ]; then
    # Dev layout: MYJARBIS_INSTALL_DIR points to <repo>/global, bin
    # lives at <repo>/bin.
    check_pass "CLI tool available at $INSTALL_DIR/../bin/myjarbis (dev layout)"
elif command -v myjarbis &> /dev/null; then
    check_pass "CLI tool available on PATH ($(command -v myjarbis))"
else
    check_fail "CLI tool not found"
fi

if [ -f "$INSTALL_DIR/mcp-server/build/index.js" ]; then
    check_pass "MCP server found"
else
    check_fail "MCP server build not found"
fi

# Check if myjarbis is in PATH
if command -v myjarbis &> /dev/null; then
    check_pass "myjarbis command in PATH"
else
    check_warn "myjarbis not in PATH (add ~/.myjarbis-global/bin to PATH)"
fi

echo ""

# [2/5] Check Claude Code integration
echo -e "${GOLD}[2/5]${NC} Checking Claude Code integration..."
echo ""

if command -v claude &> /dev/null; then
    check_pass "Claude Code CLI installed"

    # Check Claude version
    CLAUDE_VERSION=$(claude --version 2>&1 || echo "unknown")
    echo -e "       ${NC}Version: $CLAUDE_VERSION${NC}"
else
    check_fail "Claude Code CLI not found"
    echo -e "       ${YELLOW}Install from: https://docs.claude.com/claude-code${NC}"
fi

if [ -f "$CLAUDE_CONFIG" ]; then
    check_pass "Claude config file exists (~/.claude.json)"

    # Check if MCP server is configured
    if grep -q "myjarbis" "$CLAUDE_CONFIG" 2>/dev/null; then
        check_pass "MCP server configured in Claude"
    else
        check_warn "MCP server not configured in Claude"
        echo -e "       ${YELLOW}Run 'myjarbis init' in a project to configure${NC}"
    fi
else
    check_warn "Claude config file not found"
fi

# Test MCP server
if [ -f "$INSTALL_DIR/mcp-server/build/index.js" ]; then
    if timeout 2 node "$INSTALL_DIR/mcp-server/build/index.js" <<< '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"test","version":"1.0"}}}' &> /dev/null; then
        check_pass "MCP server responding"
    else
        check_warn "MCP server may have issues (this is normal if no projects registered)"
    fi
fi

echo ""

# [3/5] Check current project (if in a project)
echo -e "${GOLD}[3/5]${NC} Checking current project..."
echo ""

if [ -d ".myjarbis" ]; then
    check_pass "Project initialized (.myjarbis/ exists)"

    # Check folder structure
    if [ -f ".myjarbis/config/settings.json" ]; then
        check_pass "Settings file exists"

        # Extract project info
        PROJECT_NAME=$(grep -o '"name"[[:space:]]*:[[:space:]]*"[^"]*"' .myjarbis/config/settings.json | cut -d'"' -f4)
        FRAMEWORK=$(grep -o '"framework"[[:space:]]*:[[:space:]]*"[^"]*"' .myjarbis/config/settings.json | cut -d'"' -f4)
        echo -e "       ${NC}Project: $PROJECT_NAME ($FRAMEWORK)${NC}"
    else
        check_fail "Settings file missing"
    fi

    # Check required files
    REQUIRED_FILES=(
        ".myjarbis/context/project-summary.md"
        ".myjarbis/context/knowledge-base.md"
        ".myjarbis/context/daily.md"
        ".myjarbis/prompts/system.md"
        ".claude/commands/jarbis.md"
    )

    for file in "${REQUIRED_FILES[@]}"; do
        if [ -f "$file" ]; then
            check_pass "$(basename $file) exists"
        else
            check_warn "$(basename $file) missing"
        fi
    done

    # Check if registered in global registry
    if [ -f "$REGISTRY_FILE" ] && [ -n "$PROJECT_NAME" ]; then
        if grep -q "\"$PROJECT_NAME\"" "$REGISTRY_FILE"; then
            check_pass "Project registered in global registry"
        else
            check_warn "Project not in global registry"
        fi
    fi

    # ─── v0.2 specific checks ───
    if [ -f ".myjarbis/memory.db" ]; then
        check_pass "memory.db exists (v0.2 schema)"
    else
        check_warn "memory.db missing — run 'myjarbis init' to upgrade or seed"
    fi

    # Schema version (read meta table via node since we don't bundle sqlite3 CLI)
    CLI_JS="$INSTALL_DIR/mcp-server/build/cli.js"
    if [ -f ".myjarbis/memory.db" ] && [ -f "$CLI_JS" ]; then
        SCHEMA_OK=$(node --input-type=module -e "
            import { MyJarbisDB } from '$INSTALL_DIR/mcp-server/build/db/index.js';
            const db = MyJarbisDB.open('$CURRENT_DIR');
            const v = db.meta.get('schema_version');
            console.log(v);
            db.close();
        " 2>/dev/null || echo "?")
        if [ "$SCHEMA_OK" = "2" ]; then
            check_pass "Schema version: 2"
        else
            check_warn "Schema version: $SCHEMA_OK (expected 2)"
        fi
    fi

    # Plugin manifest + hooks + scripts
    if [ -f ".claude-plugin/plugin.json" ]; then
        check_pass "Plugin manifest installed (.claude-plugin/plugin.json)"
    else
        check_warn ".claude-plugin/plugin.json missing"
    fi
    if [ -f ".claude-plugin/hooks/hooks.json" ]; then
        check_pass "Hooks config installed (hooks.json)"
    else
        check_warn ".claude-plugin/hooks/hooks.json missing"
    fi
    HOOK_SCRIPTS=(session-start.sh user-prompt-submit.sh post-compaction.sh session-stop.sh)
    HOOKS_OK=true
    for s in "${HOOK_SCRIPTS[@]}"; do
        if [ ! -x ".claude-plugin/scripts/$s" ]; then
            HOOKS_OK=false
            check_warn "Hook not executable: .claude-plugin/scripts/$s"
        fi
    done
    if [ "$HOOKS_OK" = "true" ]; then
        check_pass "All 4 hook scripts present and executable"
    fi

    # Materialized skills
    if [ -d ".claude/skills" ]; then
        SKILL_COUNT=$(find .claude/skills -mindepth 1 -maxdepth 1 -type d -name 'myjarbis-*' 2>/dev/null | wc -l)
        if [ "$SKILL_COUNT" -gt 0 ]; then
            check_pass "Skills materialized: $SKILL_COUNT myjarbis-*/SKILL.md folders"
        else
            check_warn "No materialized skills (expected ≥7 baselines after init)"
        fi
    else
        check_warn ".claude/skills/ missing — run myjarbis skill materialize"
    fi

else
    check_warn "Not in a MyJarbis project (.myjarbis/ not found)"
    echo -e "       ${NC}Run 'myjarbis init' to initialize this project${NC}"
fi

echo ""

# [4/5] Test MCP tools (if in a project)
echo -e "${GOLD}[4/5]${NC} Testing MCP tools..."
echo ""

if [ -d ".myjarbis" ] && [ -f ".myjarbis/memory.db" ] && [ -f "$INSTALL_DIR/mcp-server/build/cli.js" ]; then
    # Run a real round-trip via the CLI: current_project → list_modules
    # → stats. If any of those fail, the MCP toolchain isn't healthy.
    ROUNDTRIP=$(node --input-type=module -e "
        import { MyJarbisDB } from '$INSTALL_DIR/mcp-server/build/db/index.js';
        const db = MyJarbisDB.open('$CURRENT_DIR');
        const project = db.projects.findByPath('$CURRENT_DIR');
        if (!project) { console.log('NO_PROJECT'); process.exit(0); }
        const modules = db.modules.listByProject(project.id);
        const skills = db.skills.listByProject(project.id);
        console.log('OK', project.name, modules.length, skills.length);
        db.close();
    " 2>&1)
    case "$ROUNDTRIP" in
        OK\ *)
            check_pass "DB round-trip OK ($ROUNDTRIP)"
            ;;
        NO_PROJECT)
            check_warn "DB exists but project row missing — re-run 'myjarbis init'"
            ;;
        *)
            check_fail "DB round-trip failed: $ROUNDTRIP"
            ;;
    esac

    # Surface the v0.2 tool surface so users know what's available
    echo -e "       ${NC}MCP tools (v0.2):${NC}"
    echo -e "       ${GOLD}current_project, list_modules, create_module${NC}"
    echo -e "       ${GOLD}start_session, end_session, resume${NC}"
    echo -e "       ${GOLD}load_project_core, load_module, search, save_observation${NC}"
    echo -e "       ${GOLD}list_skills, add_skill, materialize_skills${NC}"
    echo -e "       ${GOLD}import_md, import_json${NC}"
    echo -e "       ${NC}Legacy aliases: search_code, get_context, update_memory${NC}"
else
    check_warn "Skipping MCP tool tests (not in a project or memory.db missing)"
fi

echo ""

# [5/5] Check for common issues
echo -e "${GOLD}[5/5]${NC} Checking for issues..."
echo ""

# Check project size
if [ -d ".myjarbis" ]; then
    FILE_COUNT=$(find . -type f \
        -not -path "*/node_modules/*" \
        -not -path "*/vendor/*" \
        -not -path "*/.git/*" \
        -not -path "*/build/*" \
        -not -path "*/dist/*" \
        2>/dev/null | wc -l)

    if [ "$FILE_COUNT" -gt 10000 ]; then
        check_warn "Large project ($FILE_COUNT files) - searches may be slow"
        echo -e "       ${NC}Consider adding more patterns to .gitignore${NC}"
    else
        check_pass "Project size is reasonable ($FILE_COUNT files)"
    fi
fi

# Check Node.js version (for MCP server)
if command -v node &> /dev/null; then
    NODE_VERSION=$(node --version)
    check_pass "Node.js installed ($NODE_VERSION)"
else
    check_fail "Node.js not found (required for MCP server)"
fi

# Check for old installation
if [ -d "$HOME/.myjarvis-global" ]; then
    check_warn "Old installation found at ~/.myjarvis-global"
    echo -e "       ${NC}Remove with: rm -rf ~/.myjarvis-global${NC}"
fi

echo ""

# Summary
echo -e "${RED}╔════════════════════════════════════════════════╗${NC}"

if [ $CHECKS_FAILED -eq 0 ] && [ $WARNINGS -eq 0 ]; then
    echo -e "${RED}║${GREEN}         ✓ ALL CHECKS PASSED                  ${RED}║${NC}"
elif [ $CHECKS_FAILED -eq 0 ]; then
    echo -e "${RED}║${YELLOW}       ⚠ PASSED WITH WARNINGS                ${RED}║${NC}"
else
    echo -e "${RED}║${RED}         ✗ ISSUES DETECTED                    ${RED}║${NC}"
fi

echo -e "${RED}╚════════════════════════════════════════════════╝${NC}"
echo ""

echo -e "${GOLD}Summary:${NC}"
echo -e "  ${GREEN}Passed:${NC}   $CHECKS_PASSED"
echo -e "  ${RED}Failed:${NC}   $CHECKS_FAILED"
echo -e "  ${YELLOW}Warnings:${NC} $WARNINGS"
echo ""

if [ $CHECKS_FAILED -gt 0 ]; then
    echo -e "${GOLD}Next steps:${NC}"
    echo -e "  1. Review failed checks above"
    echo -e "  2. Run ${GOLD}myjarbis help${NC} for commands"
    echo -e "  3. Check docs: https://github.com/braiantroncoso/myjarbis"
    echo ""
    exit 1
fi

exit 0
