#!/bin/bash
#
# MyJarbis Update
#
# WHY THIS WAS REWRITTEN
# ----------------------
# The previous version did nothing useful. It ran `git pull` inside
# $HOME/.myjarbis-global — but install.sh populates that directory with
# `cp -r`, so it is a COPY, not a clone. There is no remote to pull from, so
# every run printed "not a git repository, skipping update" and then rebuilt
# the code that was already there. It also never re-copied bin/ or
# templates/, which is where hook scripts live, so a new hook could never
# reach an existing installation.
#
# This version:
#   1. pulls the source checkout (recorded at install time in .source)
#   2. re-syncs code + templates + bin into the install dir, WITHOUT
#      touching the project registry
#   3. reinstalls dependencies and rebuilds
#   4. reports which registered projects are out of date — hook scripts and
#      schema version — and refreshes their hooks with --projects
#
# It never touches a project's memory.db. Schema changes are
# `myjarbis migrate`, which backs up first.
#
# The report asks `health --json` rather than inspecting each project itself;
# see the comment at step 5 for why that mattered. And because updating swaps
# the MCP server build out from under a running Claude session, there is a
# preflight check before step 1 — nothing is touched until it passes.

set -euo pipefail

RED='\033[38;5;88m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# Paths. See bin/myjarbis for why the symlink chain is followed by hand here.
#
# Note what INSTALL_DIR must NOT become for this script: when it runs out of a
# checkout — `bash bin/myjarbis-update`, the documented way to jump versions —
# the installation it is updating is elsewhere. myjarbis-env.sh only takes the
# parent of bin/ when a templates/ sits next to it, which a checkout has under
# global/ instead.
__mj_s="${BASH_SOURCE[0]}"
while [ -L "$__mj_s" ]; do __mj_l="$(readlink "$__mj_s")"; case "$__mj_l" in /*) __mj_s="$__mj_l";; *) __mj_s="$(dirname "$__mj_s")/$__mj_l";; esac; done
. "$(cd "$(dirname "$__mj_s")" && pwd)/myjarbis-env.sh"

step() { echo -e "${RED}[$1/5]${NC}  ${BOLD}$2${NC}"; }
ok()   { echo "       OK"; }
note() { echo -e "       ${DIM}$1${NC}"; }
warn() { echo -e "       ${RED}WARN${NC}  $1"; }
fail() { echo -e "       ${RED}${BOLD}FAIL${NC}  $1"; }

# ── Never rewrite a file that something might be reading ──────────────────
#
# `cp` over an existing file rewrites it IN PLACE: same inode, new bytes. Any
# process reading that file keeps its handle and silently starts reading the
# new content. For a shell script that is fatal, because bash reads a script
# incrementally, by byte offset, rather than loading it whole — the next read
# returns the NEW bytes at the OLD offset and execution resumes mid-token.
#
# That is what crashed a real update on 2026-10-20. Step 3 copies $SOURCE/bin
# over $INSTALL_DIR/bin, and the script being executed IS
# $INSTALL_DIR/bin/myjarbis-update: it overwrote itself and died with
# `line 196: f: command not found` on a line where nothing was wrong. The bug
# had been latent through every release where the file length barely moved,
# because bash resumed close enough to a statement boundary to keep going.
# Steps 4 (rebuild) and 5 (report) never ran.
#
# `mv` is a rename: it swaps the directory entry and leaves the old inode
# alive for anyone still holding it open, so a running script reads the version
# it started with, all the way to the end. Copy beside the target, then rename
# over it.
#
# This is a property of the writer, not of the victim: the fix lives here, in
# the one place that does the replacing, so a script added to bin/ tomorrow is
# covered without its author knowing any of the above.
#
# Deliberately NOT used for the global/* trees, and the reason is the same
# mechanism rather than an exception to it: those are mcp-server/, core/ and
# templates/, and nothing in them is executed incrementally by bash. Node
# reads a module file whole, so a replaced build/*.js either loads or fails
# loudly at import. The project hook refresh at step 5 is safe for the same
# reason this helper is: it `rm -rf`s before copying, and unlinking leaves the
# running process on the old inode.
#
# One correction to the above, paid for in a dead session: that reasoning is
# true of JavaScript and FALSE of a mapped native module. node_modules used to
# be copied with the rest of this tree, and better_sqlite3.node is mmap'd by
# the running server — replacing a mapped file in place is a SIGBUS, not a
# loud import failure. Step 3 excludes node_modules for exactly that reason.
# One file into place, by rename, never written where it is read from.
sync_one_executable() {
    local f="$1" dest_dir="$2" base staged
    base="$(basename "$f")"
    if [ ! -f "$f" ]; then
        # bin/ has only ever held plain scripts. Say so out loud rather
        # than skipping in silence, so the day that changes is the day
        # someone reads this instead of debugging a missing command.
        warn "$base is not a plain file — not synced into $dest_dir"
        return 0
    fi
    staged="$dest_dir/.myjarbis-incoming.$$-$base"
    cp "$f" "$staged"
    chmod +x "$staged"
    mv -f "$staged" "$dest_dir/$base"
}

sync_executables() {
    local src_dir="$1" dest_dir="$2" f
    mkdir -p "$dest_dir"

    # A run that died mid-copy can leave a staging file behind. Sweeping them
    # first is what makes re-running the update a repair rather than a pile-up,
    # and keeps a half-written file from ever sitting next to the real commands.
    rm -f "$dest_dir"/.myjarbis-incoming.* 2>/dev/null || true

    # Libraries first, commands second. A `*.sh` in bin/ is a sourced library,
    # and every command sources myjarbis-env.sh on its first lines. Replacing
    # `myjarbis` before the library it needs is there would leave a window
    # where the command is the new one and its dependency does not exist — and
    # a window of exactly that shape is what made an update kill the session
    # running it, once.
    for f in "$src_dir"/*.sh; do
        [ -e "$f" ] || continue
        sync_one_executable "$f" "$dest_dir"
    done
    for f in "$src_dir"/*; do
        [ -e "$f" ] || continue
        case "$(basename "$f")" in *.sh) continue ;; esac
        sync_one_executable "$f" "$dest_dir"
    done
}

# Print the lines a report-mode command produced, or say there were none.
# A bare header with nothing under it reads as a bug in the reporter rather
# than as "there is nothing to do", which is the usual answer.
report_lines() {
    local out="$1" pattern="$2" empty="$3" rc="${4:-0}" n=0

    # A non-zero status means the step failed, and then the success vocabulary
    # below is the wrong filter entirely: it can only ever pass good news.
    # That is not hypothetical. `workflow reseed --all --apply` on a v4 brain
    # failed for all 23 projects with `table workflows has no column named
    # standalone`, the status
    # was discarded by `|| true`, every error line was dropped because it
    # matched none of "created|extended|left alone|unchanged", and the step
    # printed "nothing to change". Zero rows were written and the update said
    # it was done.
    #
    # So: on failure, print what the command actually said, unfiltered, and
    # say plainly that this part did not happen.
    if [ "$rc" != "0" ]; then
        fail "this step FAILED (exit $rc) — nothing was propagated for it"
        while read -r l; do
            [ -z "$l" ] && continue
            note "  $l"
        done < <(printf '%s\n' "$out" | sed 's/\x1b\[[0-9;]*m//g' | grep -vE '^\s*$' | head -12)
        STEP5_FAILURES=$((STEP5_FAILURES + 1))
        return 0
    fi

    while read -r l; do
        [ -z "$l" ] && continue
        note "  $l"
        n=$((n+1))
    done < <(printf '%s\n' "$out" | sed 's/\x1b\[[0-9;]*m//g' | grep -iE "$pattern" | head -6)
    [ "$n" = "0" ] && note "  $empty"
    return 0
}

# Counted rather than fatal: one sub-step failing should not abandon the
# others, but the run must not end with "Done" as though it all worked.
STEP5_FAILURES=0

# Propagation is ON by default.
#
# It used to be opt-in behind --projects, and the three things that need
# propagating lived behind three different commands: hooks here, slash
# commands in `commands sync`, skills in `skill reseed`. docs/UPGRADING.md
# literally introduces the skills one with "This is the step most likely to
# be forgotten", which is a design admitting its own failure mode in prose.
#
# It was forgotten, repeatedly and expensively: 23 projects ran a stale
# `/jarbis`, then 22 ran a stale hook matcher, then every project kept a
# `module-orchestration` skill ordering the agent to re-query what the hook
# had already handed it. Each time the code was fixed, each time the fleet
# was not, and each time it surfaced as "the tool got slow" rather than as
# "a propagation step was skipped".
#
# `update` means "make this machine current". If something has to be run
# afterwards for that to be true, it was part of the update.
SYNC_PROJECTS=1
SOURCE_OVERRIDE=""
SKIP_PULL=""
ASSUME_YES=""
PROJECTS_ONLY=""
DRY_RUN=""

for arg in "$@"; do
    case "$arg" in
        --projects)   SYNC_PROJECTS=1 ;;
        --no-projects) SYNC_PROJECTS="" ;;
        # Repairing a project's hooks needs nothing from the checkout: the
        # templates and the build are already in the install dir. Reinstalling
        # both just to re-copy five shell scripts also swaps the MCP build out
        # from under a running Claude session for no reason.
        --projects-only) SYNC_PROJECTS=1; PROJECTS_ONLY=1 ;;
        --no-pull)    SKIP_PULL=1 ;;
        --yes|-y)     ASSUME_YES=1 ;;
        --dry-run|-n) DRY_RUN=1 ;;
        --from=*)     SOURCE_OVERRIDE="${arg#*=}" ;;
        --help|-h)
            echo "Usage: myjarbis update [--dry-run] [--projects-only|--no-projects] [--no-pull] [--yes] [--from=<path>]"
            echo
            echo "  By default this also propagates to every registered project:"
            echo "  hook scripts and their wiring, slash commands, and baseline"
            echo "  skills (reseeded, then re-materialized to .claude/skills/ so"
            echo "  you do not have to reopen Claude in each one)."
            echo
            echo "  --projects       Kept for compatibility; this is now the default."
            echo "  --no-projects    Update this installation only, touch no project."
            echo "  --projects-only  Only propagate. Skips the pull, the re-sync and"
            echo "                   the rebuild, so a running Claude session keeps"
            echo "                   working. Use this to fix unwired projects."
            echo "  --no-pull        Re-sync from the local checkout without pulling."
            echo "  --dry-run, -n    Report what WOULD change, per project, writing nothing."
            echo "                   Worth running first, though a running Claude"
            echo "                   session now survives the real run unless the"
            echo "                   dependencies themselves changed."
            echo "  --yes, -y        Do not ask anything, even with Claude Code running."
            echo "  --from=<path>    Use this checkout as the source and remember it."
            exit 0
            ;;
        *) echo "Unknown option: $arg (try --help)" >&2; exit 1 ;;
    esac
done

echo
echo -e "${RED}${BOLD}MyJarbis${NC} · update"
echo
echo -e "  ${BOLD}Install${NC}  $INSTALL_DIR"
if [ -n "$DRY_RUN" ]; then
    echo -e "  ${BOLD}Mode${NC}     ${RED}${BOLD}dry run${NC} — nothing will be written"
fi

if [ ! -d "$INSTALL_DIR" ]; then
    fail "MyJarbis is not installed at $INSTALL_DIR"
    note "clone the repo and run ./install.sh first"
    exit 1
fi

# ─── preflight: can a running Claude session survive this run? ───────
#
# It can, now, in the ordinary case — and working out WHY it used to die is
# what made that true. Three claims, in the order they were tested:
#
#   · Replacing build/*.js under the live server does nothing to it. Every
#     import in the server is static, so all modules are resolved and in
#     memory at startup (`grep -rn 'await import(' src/` finds none).
#   · What killed it is node_modules/better-sqlite3/.../better_sqlite3.node,
#     which the process has MAPPED — `grep better_sqlite3 /proc/<pid>/maps`.
#     Replacing a mapped file in place is a SIGBUS for its reader. That is the
#     "Connection closed" everyone blamed on the JavaScript.
#   · And `cp -r global/mcp-server` was enough to cause it by itself, since
#     the checkout tree carries node_modules. npm install never had to run.
#
# So step 3 excludes node_modules, step 4 skips npm install when the
# dependency list is unchanged and builds beside the live build before
# swapping by rename. What remains is the one case that genuinely cannot be
# made safe: a dependency actually changing, which has to rewrite the mapped
# module. That is what this now warns about — and only that.
#
# A warning that fires on every run is a warning people learn to skip, which
# is the same failure as `doctor` passing green on hooks that never ran.
#
# Still before step 1: nothing has been written yet, so answering "no" leaves
# the installation exactly as it was. The source is resolved read-only here
# for the dependency comparison; step 1 is what records it.
#
# `pgrep -x` matches the process name exactly, which is what keeps this from
# matching the shell running the update, or the grep itself. Absent pgrep
# (unlikely on Linux/macOS, possible in a bare container), the check is
# skipped rather than guessed at.
#
# Skipped entirely for --projects-only: that path never rebuilds.
DEPS_CHANGED=""
if [ -z "$PROJECTS_ONLY" ] && [ -z "$DRY_RUN" ] && command -v pgrep >/dev/null 2>&1; then
    CLAUDE_PIDS="$(pgrep -x claude 2>/dev/null | tr '\n' ' ' | sed 's/ $//')" || CLAUDE_PIDS=""
    if [ -n "$CLAUDE_PIDS" ]; then
        PREFLIGHT_SOURCE=""
        if [ -n "$SOURCE_OVERRIDE" ]; then
            PREFLIGHT_SOURCE="$SOURCE_OVERRIDE"
        elif [ -f "$INSTALL_DIR/.source" ]; then
            PREFLIGHT_SOURCE="$(cat "$INSTALL_DIR/.source")"
        fi
        DEPS_CHANGED="$(node -e "
          const read = (p) => { try { return JSON.parse(require('fs').readFileSync(p,'utf8')).dependencies || {}; } catch { return null; } };
          const a = read('$INSTALL_DIR/mcp-server/package.json');
          const b = read('$PREFLIGHT_SOURCE/global/mcp-server/package.json');
          console.log(a && b && JSON.stringify(a) === JSON.stringify(b) ? '' : 'yes');
        " 2>/dev/null || echo yes)"
        # Tri-state on purpose: an EMPTY DEPS_CHANGED means "compared, and they
        # match", which step 4 must not confuse with "never compared".
        DEPS_CHECKED=1
    fi
    if [ -n "$CLAUDE_PIDS" ] && [ -z "$DEPS_CHANGED" ]; then
        note "Claude Code is running (PID ${CLAUDE_PIDS}) — and can keep running:"
        note "dependencies are unchanged, so nothing it has mapped gets replaced."
        note "the new build lands by rename; restart when convenient to pick it up."
        echo
    elif [ -n "$CLAUDE_PIDS" ]; then
        # The warning prints even with --yes. That flag says "do not ask me",
        # not "do not tell me" — someone running this from a script still
        # needs to know a session is about to lose its tools.
        warn "Claude Code is running (PID ${CLAUDE_PIDS})"
        note "dependencies CHANGED, so npm install has to replace the native"
        note "module that session has mapped: it will lose every myjarbis tool."
        if [ -z "$ASSUME_YES" ] && [ -t 0 ]; then
            # Same idiom as bin/myjarbis-init: ask only when someone is there
            # to answer. Non-interactive callers — the agent running this from
            # inside Claude, a script, CI — get the warning and proceed, which
            # is the behaviour that was chosen deliberately: blocking them
            # would make the update impossible from the place it is most often
            # requested.
            printf '       Update anyway? [y/N]: '
            read -r REPLY_UPDATE
            case "$REPLY_UPDATE" in
                y|Y|s|S|yes|YES|si|SI|sí|Sí) ;;
                *)
                    note "nothing was changed. Close Claude Code and re-run."
                    echo
                    exit 0
                    ;;
            esac
        elif [ -n "$ASSUME_YES" ]; then
            note "--yes given — continuing. Restart Claude when done."
        else
            note "no terminal to ask — continuing. Restart Claude when done."
        fi
        echo
    fi
fi

# ─── [1/5] locate the source checkout ─────────────────────────────
step 1 "Locate the source checkout"
SOURCE=""
if [ -n "$SOURCE_OVERRIDE" ]; then
    SOURCE="$SOURCE_OVERRIDE"
elif [ -f "$INSTALL_DIR/.source" ]; then
    SOURCE="$(cat "$INSTALL_DIR/.source")"
fi

if [ -z "$SOURCE" ] || [ ! -d "$SOURCE" ]; then
    # --projects-only reads nothing from the checkout, so a missing one is
    # not an error there. It is still worth resolving when available: step 5
    # uses it to refuse to overwrite the checkout with its own copy.
    if [ -n "$PROJECTS_ONLY" ]; then
        SOURCE=""
        note "no source checkout recorded — not needed for --projects-only"
        ok
    else
        fail "no usable source checkout"
        note "this installation predates update support, or the checkout moved."
        note "re-point it once and it will be remembered:"
        note "  myjarbis update --from=/path/to/myjarbis"
        exit 1
    fi
else
    SOURCE="$(cd "$SOURCE" && pwd)"
    if [ ! -d "$SOURCE/global" ] || [ ! -f "$SOURCE/install.sh" ]; then
        fail "$SOURCE does not look like a MyJarbis checkout (no global/ or install.sh)"
        exit 1
    fi
    # Only remembered on a run that actually syncs from it. --projects-only
    # may have been handed a --from purely to name the checkout to protect.
    # Not remembered in a dry run: the point is to change nothing, and
    # .source is a real write with a real consequence for the next run.
    [ -z "$PROJECTS_ONLY" ] && [ -z "$DRY_RUN" ] && printf '%s\n' "$SOURCE" > "$INSTALL_DIR/.source"
    note "$SOURCE"
    ok
fi

# Steps 2-4 are what makes `update` an installation-level operation, and
# the whole point of --projects-only is to reach step 5 without them. They
# are announced as skipped rather than silently absent: the step numbers
# are how this output gets read.
if [ -n "$PROJECTS_ONLY" ]; then

step 2 "Pull latest changes"
note "skipped — --projects-only"
ok
step 3 "Sync code, templates and CLI"
note "skipped — --projects-only"
ok
step 4 "Install dependencies and rebuild"
note "skipped — --projects-only (the running build is left alone)"
ok

elif [ -n "$DRY_RUN" ]; then

# Steps 2-4 reported rather than performed. Each one says what it WOULD do
# and, where it is cheap to find out, how much there is to do — `git` can
# answer "how far behind" without fetching, and the installed build's version
# is readable without rebuilding it.
step 2 "Pull latest changes"
if [ -n "$SKIP_PULL" ]; then
    note "would skip the pull — --no-pull given"
elif [ -d "$SOURCE/.git" ]; then
    BRANCH="$(git -C "$SOURCE" rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)"
    if [ -n "$(git -C "$SOURCE" status --porcelain 2>/dev/null)" ]; then
        warn "the checkout has uncommitted changes — a real run would NOT pull"
        note "it would install what is in the working tree, on branch $BRANCH"
    else
        BEHIND="$(git -C "$SOURCE" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo '?')"
        if [ "$BEHIND" = "0" ]; then
            note "branch $BRANCH is up to date with its upstream"
        else
            note "branch $BRANCH is $BEHIND commit(s) behind its upstream"
        fi
    fi
else
    note "not a git checkout — would install the files as they are"
fi
ok

step 3 "Sync code, templates and CLI"
note "would copy $SOURCE/global/* into $INSTALL_DIR (except the registry)"
note "and $SOURCE/bin/* into $INSTALL_DIR/bin"
INSTALLED_VER="$(node -e "try{console.log(require('$INSTALL_DIR/mcp-server/package.json').version)}catch(e){console.log('?')}" 2>/dev/null || echo '?')"
SOURCE_VER="$(node -e "try{console.log(require('$SOURCE/global/mcp-server/package.json').version)}catch(e){console.log('?')}" 2>/dev/null || echo '?')"
note "version: installed $INSTALLED_VER → source $SOURCE_VER"
# Reported from the same conditions the real run uses, so the two cannot
# disagree about whether there is anything left to move.
if [ -z "${MYJARBIS_REGISTRY:-}" ] && [ "$REGISTRY_FILE" = "$MYJARBIS_REGISTRY_LEGACY" ]; then
    note "would move the registry out of the install dir, to $MYJARBIS_STATE_DIR/projects-registry.json"
    note "leaving a copy at the old path"
fi
if [ -d "$MYJARBIS_BACKUPS_LEGACY" ] && [ "$MYJARBIS_BACKUPS_LEGACY" != "$BACKUPS_DIR" ]; then
    note "would move $(find "$MYJARBIS_BACKUPS_LEGACY" -maxdepth 1 -mindepth 1 | wc -l | tr -d ' ') brain backup(s) to $BACKUPS_DIR"
fi
note "would write the MCP launcher at $MCP_LAUNCHER"
if [ -f "$HOME/.claude.json" ]; then
    DRY_ENTRIES="$(MYJARBIS_MCP_LAUNCHER="$MCP_LAUNCHER" python3 - "$HOME/.claude.json" 2>/dev/null <<'PYTHON_EOF' || echo '?'
import json, os, sys
launcher = os.environ['MYJARBIS_MCP_LAUNCHER']
try:
    with open(sys.argv[1]) as f:
        data = json.load(f)
except ValueError:
    print('?')
    sys.exit(0)
n = 0
for entry in (data.get('projects') or {}).values():
    server = (entry.get('mcpServers') or {}).get('myjarbis')
    if not isinstance(server, dict):
        continue
    command = server.get('command')
    args = server.get('args') or []
    if command == 'node' and any(
        isinstance(a, str) and a.endswith('mcp-server/build/index.js') for a in args
    ):
        n += 1
    elif isinstance(command, str) and command.endswith('/bin/myjarbis-mcp') and command != launcher:
        n += 1
print(n)
PYTHON_EOF
)"
    [ "$DRY_ENTRIES" = "0" ] \
        || note "would point $DRY_ENTRIES project(s) in ~/.claude.json at it"
fi
ok

step 4 "Install dependencies and rebuild"
# Reported from the same comparison the real run acts on, not from a guess
# about it: the two must not be able to disagree.
DRY_DEPS_CHANGED="$(node -e "
  const read = (p) => { try { return JSON.parse(require('fs').readFileSync(p,'utf8')).dependencies || {}; } catch { return null; } };
  const a = read('$INSTALL_DIR/mcp-server/package.json');
  const b = read('$SOURCE/global/mcp-server/package.json');
  console.log(a && b && JSON.stringify(a) === JSON.stringify(b) ? '' : 'yes');
" 2>/dev/null || echo yes)"
if [ -n "$DRY_DEPS_CHANGED" ]; then
    note "would run npm install in $INSTALL_DIR/mcp-server (dependencies changed)"
    warn "that is the step a running Claude session cannot survive"
    note "npm install replaces the native module the session has mapped"
else
    note "would skip npm install — dependencies are unchanged"
    note "a running Claude session survives this run; node_modules is not touched"
fi
note "would build into mcp-server/build.next, then swap it in by rename"
ok

else

# ─── [2/5] pull ───────────────────────────────────────────────────
step 2 "Pull latest changes"
if [ -n "$SKIP_PULL" ]; then
    note "--no-pull given, using the checkout as it is"
elif [ -d "$SOURCE/.git" ]; then
    BRANCH="$(git -C "$SOURCE" rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)"
    if [ -n "$(git -C "$SOURCE" status --porcelain 2>/dev/null)" ]; then
        warn "the checkout has uncommitted changes — not pulling"
        note "installing what is in the working tree instead"
    elif git -C "$SOURCE" pull --ff-only 2>&1 | sed 's/^/       /'; then
        note "branch: $BRANCH"
    else
        warn "pull failed — installing the current checkout instead"
    fi
else
    note "not a git checkout, using the files as they are"
fi
ok

# ─── [3/5] sync files ─────────────────────────────────────────────
step 3 "Sync code, templates and CLI"
# Answered BEFORE the sync, because the sync overwrites the very file the
# answer is read from. `npm install` is the one step that can replace the
# mapped native module, so whether it is needed decides whether a running
# session is at risk at all — see the preflight, which asks this first when
# a session is open and records that it did.
if [ -z "${DEPS_CHECKED:-}" ]; then
    DEPS_CHANGED="$(node -e "
      const read = (p) => { try { return JSON.parse(require('fs').readFileSync(p,'utf8')).dependencies || {}; } catch { return null; } };
      const a = read('$INSTALL_DIR/mcp-server/package.json');
      const b = read('$SOURCE/global/mcp-server/package.json');
      // A missing or unreadable manifest counts as changed: unknown is not safe.
      console.log(a && b && JSON.stringify(a) === JSON.stringify(b) ? '' : 'yes');
    " 2>/dev/null || echo yes)"
fi
# The registry is state owned by this installation, and a developer's
# checkout can contain a stale copy of it. Never overwrite it.
REGISTRY_BACKUP=""
if [ -f "$REGISTRY_FILE" ]; then
    REGISTRY_BACKUP="$(mktemp)"
    cp "$REGISTRY_FILE" "$REGISTRY_BACKUP"
fi

for item in "$SOURCE"/global/*; do
    base="$(basename "$item")"
    [ "$base" = "projects-registry.json" ] && continue
    rm -rf "$INSTALL_DIR/$base.old" 2>/dev/null || true
    if [ "$base" = "mcp-server" ]; then
        # Everything EXCEPT node_modules/ and build/, and the exclusion is the
        # whole reason this update no longer needs Claude closed.
        #
        # node_modules: the live server has
        # node_modules/better-sqlite3/build/Release/better_sqlite3.node MAPPED
        # into its address space — `grep better_sqlite3 /proc/<pid>/maps` shows
        # it. Overwriting a mapped file in place is a SIGBUS for the reader, and
        # that is the "Connection closed" this script used to cause, wrongly
        # attributed to the JavaScript. `cp -r` of the source tree was enough to
        # do it on its own, before npm install ever ran.
        #
        # build: it is produced by step 4, which stages and renames rather than
        # writing in place. Copying the checkout's build over it here would undo
        # that and reintroduce a window where the directory is half-replaced.
        mkdir -p "$INSTALL_DIR/mcp-server"
        for sub in "$item"/*; do
            case "$(basename "$sub")" in
                node_modules|build) continue ;;
            esac
            cp -r "$sub" "$INSTALL_DIR/mcp-server/"
        done
    else
        cp -r "$item" "$INSTALL_DIR/"
    fi
done
# By rename, not in place: this is the copy that used to kill the running
# update. See sync_executables at the top for why.
sync_executables "$SOURCE/bin" "$INSTALL_DIR/bin"
# Stray brains a checkout may have accumulated are not part of the product.
# backups/ is excluded: like the registry, it is state owned by this
# installation, not code coming from the checkout. The snapshots under it
# contain a project's own .myjarbis/ by design, and a sync must not eat them.
find "$INSTALL_DIR" \
    -path "$INSTALL_DIR/backups" -prune -o \
    -type d -name '.myjarbis' -prune -exec rm -rf {} + 2>/dev/null || true

# The registry this step just read may still be the legacy one, sitting inside
# the directory the step above replaces. That is the one place it must not be:
# a package manager owns that directory and `pnpm up -g` would take the user's
# project list with it. Moving it here, rather than in myjarbis-env.sh, is so
# that moving a user's file is a step that reports itself and that --dry-run
# can decline to do.
RELOCATE_REGISTRY=""
if [ -z "${MYJARBIS_REGISTRY:-}" ] && [ "$REGISTRY_FILE" = "$MYJARBIS_REGISTRY_LEGACY" ]; then
    REGISTRY_FILE="$MYJARBIS_STATE_DIR/projects-registry.json"
    RELOCATE_REGISTRY=1
fi

if [ -n "$REGISTRY_BACKUP" ]; then
    mkdir -p "$(dirname "$REGISTRY_FILE")"
    cp "$REGISTRY_BACKUP" "$REGISTRY_FILE"
    rm -f "$REGISTRY_BACKUP"
    COUNT=$(node -e "
      try {
        const r = JSON.parse(require('fs').readFileSync('$REGISTRY_FILE','utf8'));
        console.log(Object.keys(r.projects || {}).length);
      } catch { console.log('?'); }
    ")
    note "registry preserved ($COUNT project(s))"
    if [ -n "$RELOCATE_REGISTRY" ]; then
        note "registry moved out of the install dir → $REGISTRY_FILE"
        # The old path keeps a copy rather than disappearing. Anything not yet
        # updated — a project whose hooks are older, a script someone wrote —
        # then reads the same content instead of nothing, and a reader is
        # never worse off for this having run.
        cp "$REGISTRY_FILE" "$MYJARBIS_REGISTRY_LEGACY" 2>/dev/null || true
        note "a copy stays behind for anything that has not been updated yet"
    fi
fi

# The brain backups, by the same argument: snapshots of the user's own work,
# in a directory an update replaces wholesale.
if [ -d "$MYJARBIS_BACKUPS_LEGACY" ] && [ "$MYJARBIS_BACKUPS_LEGACY" != "$BACKUPS_DIR" ]; then
    mkdir -p "$BACKUPS_DIR"
    MOVED=0
    # One by one, and never over an existing name: the destination can already
    # hold snapshots, and a wholesale move would put the old directory on top
    # of them.
    for snap in "$MYJARBIS_BACKUPS_LEGACY"/*; do
        [ -e "$snap" ] || continue
        [ -e "$BACKUPS_DIR/$(basename "$snap")" ] && continue
        if mv "$snap" "$BACKUPS_DIR/"; then
            MOVED=$((MOVED + 1))
        else
            warn "could not move $(basename "$snap") — it stays at the old path"
        fi
    done
    rmdir "$MYJARBIS_BACKUPS_LEGACY" 2>/dev/null || true
    [ "$MOVED" -eq 0 ] || note "$MOVED brain backup(s) moved → $BACKUPS_DIR"
fi

# The launcher learns where the code is now. Rewritten on every update, not
# only when it is missing: the whole point of the file is to be the one place
# that has to know, so it has to be the one place that gets told.
mj_write_mcp_launcher

# And the projects that still start the server by a path into the install dir
# are pointed at the launcher instead. One entry per project in a file that
# belongs to Claude Code, each carrying the location of the code — that is as
# many places to fix as there are projects, every time the code moves.
CLAUDE_JSON="$HOME/.claude.json"

# A function rather than an inline substitution: a heredoc nested inside
# `$( )` is a shape that reads as working and does not.
rewrite_mcp_entries() {
    MYJARBIS_MCP_LAUNCHER="$MCP_LAUNCHER" python3 - "$CLAUDE_JSON" 2>/dev/null <<'PYTHON_EOF' || echo error
import json, os, shutil, sys, tempfile, time

path = sys.argv[1]
launcher = os.environ['MYJARBIS_MCP_LAUNCHER']

try:
    with open(path) as f:
        data = json.load(f)
except ValueError:
    # Not ours to repair, and not worth aborting an update over. init takes
    # the same line on an unparseable file.
    print('unparseable')
    sys.exit(0)

changed = []
for project, entry in (data.get('projects') or {}).items():
    server = (entry.get('mcpServers') or {}).get('myjarbis')
    if not isinstance(server, dict):
        continue
    command = server.get('command')
    args = server.get('args') or []
    points_at_build = command == 'node' and any(
        isinstance(a, str) and a.endswith('mcp-server/build/index.js') for a in args
    )
    # A launcher from an earlier run whose path is no longer the current one.
    stale_launcher = (
        isinstance(command, str)
        and command.endswith('/bin/myjarbis-mcp')
        and command != launcher
    )
    if not (points_at_build or stale_launcher):
        continue
    server['command'] = launcher
    server['args'] = []
    changed.append(project)

if not changed:
    print('0')
    sys.exit(0)

shutil.copy2(path, f'{path}.bak-{int(time.time() * 1000)}')
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix='.claude.json.')
with os.fdopen(fd, 'w') as f:
    json.dump(data, f, indent=2)
shutil.copymode(path, tmp)
os.replace(tmp, path)
print(len(changed))
PYTHON_EOF
}

if [ -f "$CLAUDE_JSON" ]; then
    REWRITTEN="$(rewrite_mcp_entries)"
    case "$REWRITTEN" in
        0)           : ;;
        unparseable) warn "~/.claude.json does not parse — left untouched" ;;
        error)       warn "could not read ~/.claude.json — the MCP entries were left as they are" ;;
        *)           note "$REWRITTEN project(s) now start the server through $MCP_LAUNCHER" ;;
    esac
fi
ok

# ─── [4/5] dependencies + build ───────────────────────────────────
step 4 "Install dependencies and rebuild"
cd "$INSTALL_DIR/mcp-server"

# Only when the dependency list actually changed. Skipping it is not an
# optimisation: npm install rewrites better_sqlite3.node, which a running
# server has mapped, and a mapped file replaced under its reader is a SIGBUS.
if [ -n "$DEPS_CHANGED" ]; then
    warn "dependencies changed — npm install will replace the native module"
    note "a running Claude session cannot survive this one; it must restart"
    npm install --silent 2>&1 | grep -v "npm WARN" || true
else
    note "dependencies unchanged — npm install skipped (nothing to install)"
fi

# Built BESIDE the live build, then swapped by rename. tsc writing straight
# into build/ leaves it half-replaced for as long as the compile takes, and
# that is the window a running session reads in. A rename is atomic, and the
# running process holds the old inode, so it keeps the build it started with
# until it restarts.
rm -rf build.next
# The package's own `build` script stays the source of truth for HOW to
# build — hardcoding `tsc` here broke the sandbox install in
# tests/v045-update-self-overwrite.sh, which declares a dependency-free build
# script on purpose so step 4 is a real run without reaching the network.
# What changes is only WHERE the output lands.
BUILD_SCRIPT="$(node -e "try{process.stdout.write(String((require('$INSTALL_DIR/mcp-server/package.json').scripts||{}).build||''))}catch(e){}" 2>/dev/null || true)"

case "$BUILD_SCRIPT" in
    tsc|tsc\ *)
        # tsc takes --outDir, so the new build can be compiled BESIDE the live
        # one and renamed in. No window at all: build/ is a complete build
        # before the swap and a complete build after it, which matters because
        # a project's hooks resolve <install>/mcp-server/build/cli.js by path
        # and one firing mid-compile would otherwise find half a directory.
        BUILD_MODE="staged"
        BUILD_CMD="npm run build -- --outDir build.next"
        ;;
    *)
        # Anything else: move the live build aside, build, and restore it if
        # the build fails. The running server is still safe — it holds the old
        # inode, which is now called build.prev — but there IS a window with no
        # build/ on disk, for as long as the build takes.
        BUILD_MODE="aside"
        BUILD_CMD="npm run build"
        ;;
esac

build_failed() {
    if [ "$BUILD_MODE" = "aside" ] && [ -d build.prev ] && [ ! -f build/index.js ]; then
        rm -rf build
        mv build.prev build
        note "the previous build was restored"
    fi
    rm -rf build.next
    fail "$1 — the live build was left untouched"
    exit 1
}

if [ "$BUILD_MODE" = "aside" ]; then
    rm -rf build.prev
    [ -d build ] && mv build build.prev
fi

if $BUILD_CMD 2>&1 | tail -1 | sed 's/^/       /'; then
    if [ "$BUILD_MODE" = "staged" ]; then
        if [ -f "build.next/index.js" ]; then
            rm -rf build.prev
            # Two renames. The first keeps the previous build as the rollback
            # rather than deleting it: a build that compiles is not yet a build
            # that runs, and `mv build.prev build` is the whole way back.
            [ -d build ] && mv build build.prev
            mv build.next build
            note "build swapped by rename · rollback in build.prev"
            ok
        else
            build_failed "build produced no index.js"
        fi
    elif [ -f "build/index.js" ]; then
        note "built fresh · previous build kept in build.prev"
        ok
    else
        build_failed "build produced no index.js"
    fi
else
    build_failed "build failed"
fi

VERSION=$(node -e "console.log(require('$INSTALL_DIR/mcp-server/package.json').version)" 2>/dev/null || echo '?')
SCHEMA=$(node --input-type=module -e "
  import { SCHEMA_VERSION } from '$INSTALL_DIR/mcp-server/build/db/schema.js';
  console.log(SCHEMA_VERSION);
" 2>/dev/null || echo '?')
note "mcp-server $VERSION · schema v$SCHEMA"

fi  # end of the steps 2-4 block skipped by --projects-only

# ─── [5/5] report (and optionally refresh) registered projects ────
step 5 "Propagate to registered projects"
if [ ! -f "$REGISTRY_FILE" ]; then
    note "no registry yet — nothing to check"
    ok
else
    # Per project: are its hook scripts current, and is its brain on the
    # current schema? Reported separately because they are fixed by
    # different commands — one is a file copy, the other needs a backup.
    #
    # This asks `health --json` instead of working it out here. The previous
    # version looked for `<project>/.myjarbis/memory.db` with existsSync, and
    # the v4 shared-brain migration retired those files — so on any machine
    # that moved to the shared brain it reported "no brain yet" for EVERY
    # project and the "older schema" warning below could never fire. It was
    # also a worse copy of resolution logic that already exists: collectHealth
    # (global/mcp-server/src/health.ts) resolves each project the way the rest
    # of the system does and already returns schema, isolation and hook
    # staleness. One source of truth, and it has test coverage.
    REPORT=$(node "$INSTALL_DIR/mcp-server/build/cli.js" health --json 2>/dev/null | node -e "
let raw = '';
process.stdin.on('data', (d) => (raw += d));
process.stdin.on('end', () => {
  let report;
  try { report = JSON.parse(raw); } catch { process.exit(0); }
  for (const p of report.projects || []) {
    if (!p.pathExists) {
      console.log(['GONE', p.name, p.path || '?'].join('\t'));
      continue;
    }
    // schema === null now genuinely means 'this project has no brain',
    // rather than 'no brain file sits next to it'.
    const schema = p.schema === null ? 'none' : p.schemaCurrent ? 'current' : 'v' + p.schema;
    // p.wiring is the field that makes an unwired project visible. Scripts
    // can be byte-identical to the template and still be bound to nothing,
    // and that combination used to print as 'up to date'.
    console.log(
      ['OK', p.name, p.path, p.hooks, schema, p.isolation || '?', p.wiring || 'unknown'].join('\t'),
    );
  }
});
" 2>/dev/null || true)

    STALE_HOOKS=0
    UNWIRED_HOOKS=0
    OLD_SCHEMA=0
    while IFS=$'\t' read -r status name dir hooks schema isolation wiring; do
        [ -z "${status:-}" ] && continue
        if [ "$status" = "GONE" ]; then
            note "$name — path is gone, skipping ($dir)"
            continue
        fi
        LINE="$name"
        # Where the brain lives, so a wrong schema reading is visible at a
        # glance instead of having to be trusted. This is the field whose
        # absence hid the bug: everything read "no brain yet" and looked fine.
        [ -n "${isolation:-}" ] && [ "$isolation" != "?" ] && LINE="$LINE · $isolation"
        [ "$hooks" != "current" ] && { LINE="$LINE · hooks $hooks"; STALE_HOOKS=$((STALE_HOOKS+1)); }
        # Separate from staleness on purpose: 'stale' is repaired by copying
        # the template, 'unwired' by `hook install claude`. A project can need
        # one, the other, or both.
        case "${wiring:-unknown}" in
            wired|unknown) ;;
            *) LINE="$LINE · $wiring"; UNWIRED_HOOKS=$((UNWIRED_HOOKS+1)) ;;
        esac
        [ "$schema" != "current" ] && [ "$schema" != "none" ] && { LINE="$LINE · schema $schema"; OLD_SCHEMA=$((OLD_SCHEMA+1)); }
        # "none" means the project has no brain at all, which is not staleness.
        if [ "$hooks" = "current" ] && [ "${wiring:-unknown}" != "unwired" ] \
           && [ "${wiring:-unknown}" != "partial" ] \
           && { [ "$schema" = "current" ] || [ "$schema" = "none" ]; }; then
            LINE="$LINE · up to date"
            [ "$schema" = "none" ] && LINE="$LINE (no brain yet)"
        fi
        note "$LINE"
    done <<< "$REPORT"

    NEEDS_HOOKS=$((STALE_HOOKS + UNWIRED_HOOKS))
    if [ -n "$SYNC_PROJECTS" ] && [ "$NEEDS_HOOKS" -gt 0 ]; then
        echo
        # Hooks only. This used to say "hooks + commands", which was never
        # true: the loop below copies .claude-plugin/ and nothing else.
        # Commands are files in .claude/commands/ and have their own
        # propagation path, `myjarbis commands sync`.
        if [ -n "$DRY_RUN" ]; then
            note "$NEEDS_HOOKS project(s) would have their hooks touched:"
        else
            note "refreshing hooks in $NEEDS_HOOKS project(s)..."
        fi
        while IFS=$'\t' read -r status name dir hooks schema isolation wiring; do
            [ "${status:-}" != "OK" ] && continue
            # The skip condition used to be `hooks = current` alone, which
            # excluded every project whose scripts were fresh but bound to
            # nothing — i.e. all the ones that most needed this loop. Only
            # skip when BOTH questions come back clean.
            WANT_COPY=1; WANT_WIRE=1
            [ "$hooks" = "current" ] && WANT_COPY=
            case "${wiring:-unknown}" in wired) WANT_WIRE= ;; esac
            [ -z "$WANT_COPY" ] && [ -z "$WANT_WIRE" ] && continue

            # Never overwrite the source checkout's templates with the
            # installed copy. This repo tracks templates/.claude-plugin as the
            # original; the template we copy FROM is a snapshot of it. When
            # they differ it is normally because the checkout is ahead, so
            # copying here would silently revert work in progress.
            #
            # But that hazard is about the COPY, and this used to `continue`,
            # which also skipped the WIRING — and the wiring is not copied from
            # any snapshot, it is written from CLAUDE_HOOKS in code. So the one
            # project that could never be re-wired was the developer's own
            # checkout: add a matcher, propagate it to all 22 others, and the
            # repo you actually work in keeps the stale binding. It is the last
            # place you would look, because it is the place you assume is
            # current.
            if [ -n "$SOURCE" ] && [ "$(cd "$dir" 2>/dev/null && pwd)" = "$SOURCE" ]; then
                note "  $name — source checkout: re-wiring only, templates left alone"
                WANT_COPY=
            fi

            if [ -n "$DRY_RUN" ]; then
                # Reported, not repaired. The two halves are named separately
                # because they are fixed by different things and a reader needs
                # to know which one is wrong.
                WOULD=""
                [ -n "$WANT_COPY" ] && WOULD="replace .claude-plugin/"
                if [ -n "$WANT_WIRE" ]; then
                    [ -n "$WOULD" ] && WOULD="$WOULD + "
                    WOULD="${WOULD}rewrite the hook wiring"
                fi
                note "  $name — would $WOULD"
                continue
            fi

            if [ -n "$WANT_COPY" ] && [ -d "$INSTALL_DIR/templates/.claude-plugin" ]; then
                rm -rf "$dir/.claude-plugin"
                cp -r "$INSTALL_DIR/templates/.claude-plugin" "$dir/.claude-plugin"
                chmod +x "$dir"/.claude-plugin/scripts/*.sh 2>/dev/null || true
            fi
            # Re-assert the wiring whether or not we copied. Refreshing the
            # scripts without it would leave a project that predates the
            # wiring with new scripts nobody runs, and a project with fresh
            # scripts and no wiring needs only this half.
            if ( cd "$dir" && node "$INSTALL_DIR/mcp-server/build/cli.js" hook install claude ) >/dev/null 2>&1; then
                if [ -n "$WANT_COPY" ]; then
                    note "  $name — hooks refreshed and wired"
                else
                    note "  $name — hooks wired (scripts were already current)"
                fi
            else
                note "  $name — wiring failed (run, from inside it: myjarbis hook install claude)"
            fi
        done <<< "$REPORT"
    elif [ "$NEEDS_HOOKS" -gt 0 ]; then
        echo
        [ "$STALE_HOOKS" -gt 0 ] && warn "$STALE_HOOKS project(s) have out-of-date hook scripts"
        # Worth its own line: the scripts are fine, so nothing looks wrong
        # until you notice the session greeting never appears.
        [ "$UNWIRED_HOOKS" -gt 0 ] && warn "$UNWIRED_HOOKS project(s) have hooks bound to no event — they never run"
        note "fix them with: myjarbis update"
        note "(it replaces .claude-plugin/ and rewrites .claude/settings.local.json — memory.db is never touched)"
    fi

    # ── Slash commands ──────────────────────────────────────────────
    #
    # Files in each project's .claude/commands/. `commands sync --all`
    # walks the registry itself, and classifies before writing: a copy
    # byte-identical to any template this repo has ever shipped is
    # `old-shipped-version` and gets updated, while one a human edited is
    # `diverged` and is left alone until someone passes --force. So this is
    # safe to run unattended — the guard is in the classifier, not in the
    # user remembering to run it.
    if [ -n "$SYNC_PROJECTS" ]; then
        # `MYJARBIS_PROJECT` names one project and short-circuits resolution
        # for EVERY target, so `--all` would silently collapse to that one.
        # Plausible whenever update is run from inside a project, which is
        # the normal case. Unset it for these calls only.
        MJ_CLI=(env -u MYJARBIS_PROJECT node "$INSTALL_DIR/mcp-server/build/cli.js")

        # `|| true` on every one of these: the self-overwrite suite runs this
        # script against a STUB mcp-server whose build/cli.js does not exist,
        # and `set -euo pipefail` would turn a missing file into a failed
        # update. The same applies to the greps — grep exits 1 when it matches
        # nothing, and under pipefail that kills the run.
        echo
        # `--apply` is what makes these WRITE. Dropping it is the whole dry
        # run: the classification is identical either way, so the report is
        # exactly the list a real run would act on, produced by the same code
        # rather than by a prediction that can drift from it.
        APPLY_FLAG="--apply"
        [ -n "$DRY_RUN" ] && APPLY_FLAG=""
        if [ -n "$DRY_RUN" ]; then
            note "slash commands that would change:"
        else
            note "syncing slash commands..."
        fi
        CMD_OUT=$("${MJ_CLI[@]}" commands sync --all $APPLY_FLAG 2>&1) && CMD_RC=0 || CMD_RC=$?
        report_lines "$CMD_OUT" "updated|wrote|current|diverged|Nothing|Every project" "nothing to change" "$CMD_RC"

        # ── Baseline skills ─────────────────────────────────────────
        #
        # Skills are ROWS in the brain, not files, so `update` copying code
        # never reached them. `skill reseed --all` walks the registry and
        # compares content hashes; it refuses `interaction-style`, which is
        # composed per project from the user's language and persona and would
        # otherwise be replaced by a placeholder everywhere at once. That
        # exclusion is why this can run without --include-owned, and the
        # reseed test exists to catch anyone who adds that flag here.
        #
        # The hazard that remains, and why the backup below is not optional:
        # reseed has no equivalent of `commands sync`'s `diverged` + `--force`
        # gate. A baseline skill someone hand-edited hashes differently from
        # the shipped one — exactly like a stale copy does — so it is rewritten
        # with no warning. Up to 9 project-level rows per project, no deletes,
        # but across a shared brain there is no transaction spanning projects:
        # a failure halfway leaves a partial reseed.
        if [ -z "$DRY_RUN" ] && [ -f "$INSTALL_DIR/mcp-server/build/cli.js" ]; then
            BRAIN="${MYJARBIS_HOME:-$HOME/.myjarbis}/memory.db"
            if [ -f "$BRAIN" ]; then
                BACKUP_DIR="$BACKUPS_DIR"
                mkdir -p "$BACKUP_DIR"
                BACKUP="$BACKUP_DIR/memory.db.pre-reseed-$(date +%Y%m%d-%H%M%S)"
                # -wal and -shm too: copying the main file alone can capture a
                # database whose newest writes are still in the log.
                cp "$BRAIN" "$BACKUP" 2>/dev/null || true
                cp "$BRAIN-wal" "$BACKUP-wal" 2>/dev/null || true
                cp "$BRAIN-shm" "$BACKUP-shm" 2>/dev/null || true
                note "brain backed up to ${BACKUP#"$INSTALL_DIR"/}"
            fi
        fi

        if [ -n "$DRY_RUN" ]; then
            note "baseline skills that would change:"
        else
            note "reseeding baseline skills..."
        fi
        SKILL_OUT=$("${MJ_CLI[@]}" skill reseed --all $APPLY_FLAG 2>&1) && SKILL_RC=0 || SKILL_RC=$?
        report_lines "$SKILL_OUT" "updated|inserted|unchanged|project" "nothing to change" "$SKILL_RC"

        # ── Baseline workflows ──────────────────────────────────────
        #
        # Rows too, and until now `update` did not carry them at all — so the
        # four baselines `init` seeds would have reached new projects only,
        # which is exactly the trap `skill reseed` and `commands sync` were
        # built to close. "Anything seeded by init needs a propagation path on
        # day one, or improving it silently helps nobody who already uses the
        # tool."
        #
        # Safe unattended for the same reason reseed is, and a stronger one: it
        # never reverts a step overridden at project or user scope, so a team
        # that turned a gate off keeps it off.
        if [ -n "$DRY_RUN" ]; then
            note "baseline workflows that would change:"
        else
            note "reseeding baseline workflows..."
        fi
        WF_OUT=$("${MJ_CLI[@]}" workflow reseed --all $APPLY_FLAG 2>&1) && WF_RC=0 || WF_RC=$?
        report_lines "$WF_OUT" "created|extended|left alone|unchanged|nothing to do" "nothing to change" "$WF_RC"

        # ── And onto disk ───────────────────────────────────────────
        #
        # Reseed writes rows; `.claude/skills/*/SKILL.md` is what Claude Code
        # indexes. That re-materialisation used to happen only on the next
        # SessionStart, which is the step that turned "run one command" into
        # "now reopen Claude in twenty-three projects".
        #
        # `--no-cleanup` on purpose: without it, a project with no open
        # session materializes project-level skills only AND deletes the
        # myjarbis-* folders a previous module session left behind. Harmless
        # in the end — SessionStart rebuilds them — but an update has no
        # business deleting anything, and strictly additive is the behaviour
        # that needs no explanation. Only myjarbis-* folders are ever touched
        # either way, so a user-authored skill beside them is never at risk.
        if [ -n "$DRY_RUN" ]; then
            note "skills that would be written to disk:"
        else
            note "re-materializing skills to disk..."
        fi
        MAT_OK=0; MAT_FAIL=0
        PERM_OK=0
        MAT_WOULD=0
        while IFS=$'\t' read -r status name dir hooks schema isolation wiring; do
            [ "${status:-}" != "OK" ] && continue
            if [ -n "$DRY_RUN" ]; then
                # `--dry-run` reports the same `written` list a real run acts
                # on, computed by the same comparison.
                N=$( ( cd "$dir" && env -u MYJARBIS_PROJECT node \
                       "$INSTALL_DIR/mcp-server/build/cli.js" skill materialize \
                       --no-cleanup --dry-run 2>/dev/null ) \
                     | node -e "let r='';process.stdin.on('data',d=>r+=d).on('end',()=>{try{console.log((JSON.parse(r).written||[]).length)}catch(e){console.log('?')}})" 2>/dev/null || echo '?')
                if [ "$N" != "0" ] && [ "$N" != "?" ]; then
                    note "  $name — $N skill file(s) would be written"
                    MAT_WOULD=$((MAT_WOULD+1))
                fi
                continue
            fi
            if ( cd "$dir" && env -u MYJARBIS_PROJECT node \
                 "$INSTALL_DIR/mcp-server/build/cli.js" skill materialize --no-cleanup ) >/dev/null 2>&1; then
                MAT_OK=$((MAT_OK+1))
            else
                MAT_FAIL=$((MAT_FAIL+1))
                note "  $name — could not materialize (run inside it: myjarbis skill materialize)"
            fi

            # `hook install claude` again, for EVERY project, not just the ones
            # the report flagged.
            #
            # The repair loop above is gated on NEEDS_HOOKS > 0 and skips any
            # project whose hooks are already current and wired — correct for
            # hooks, wrong for everything else `hook install claude` now does.
            # It also merges the baseline permission allowlist, and a fleet
            # whose hooks are all healthy is exactly the fleet that would never
            # receive it: 23 projects reported "up to date" and got 0 of 6
            # entries. Anything idempotent belongs outside the gate; the call
            # rewrites nothing when the file already says it, and reports
            # "already wired (no changes)".
            if ( cd "$dir" && env -u MYJARBIS_PROJECT node \
                 "$INSTALL_DIR/mcp-server/build/cli.js" hook install claude ) >/dev/null 2>&1; then
                PERM_OK=$((PERM_OK+1))
            fi
        done <<< "$REPORT"
        if [ -n "$DRY_RUN" ]; then
            if [ "$MAT_WOULD" = "0" ]; then
                note "  every project already has its skills on disk"
            else
                note "  $MAT_WOULD project(s) would get new skill files"
            fi
            echo
            note "NOTHING WAS WRITTEN. Re-run without --dry-run to apply."
            if [ -n "${DRY_DEPS_CHANGED:-}" ]; then
                note "Close Claude Code first: the dependencies changed, so step 4"
                note "has to replace the native module a running session mapped."
            else
                note "Claude Code can stay open — step 4 touches no node_modules"
                note "and swaps the build by rename."
            fi
        else
            note "  $MAT_OK project(s) re-materialized$([ "$MAT_FAIL" -gt 0 ] && echo ", $MAT_FAIL failed")"
            note "  $PERM_OK project(s) have the read-only permission baseline"
            note "no need to reopen Claude for the skills — they are on disk now"
        fi
    else
        note "skipped projects (--no-projects): commands and skills not propagated"
    fi

    if [ "$OLD_SCHEMA" -gt 0 ]; then
        echo
        warn "$OLD_SCHEMA project(s) are on an older schema"
        note "they keep working as-is. To upgrade, from inside each project:"
        note "  myjarbis migrate --dry-run     # report, change nothing"
        note "  myjarbis migrate               # backs up first, WAL included"
        note "deliberately NOT automatic: a schema change should be something"
        note "you chose, with a backup you know about."
    fi
    ok
fi

echo
if [ -n "$DRY_RUN" ]; then
    echo -e "${RED}${BOLD}Dry run${NC}"
    echo
    echo -e "  Nothing was written. To apply: ${BOLD}myjarbis update${NC}"
elif [ "$STEP5_FAILURES" -gt 0 ]; then
    # Not "Done". The installation was updated, but something it was asked to
    # propagate did not happen, and the exit code says so — a wrapper or a CI
    # step that trusted exit 0 is exactly how this went unnoticed the first time.
    echo -e "${RED}${BOLD}Done, with ${STEP5_FAILURES} failed propagation step(s)${NC}"
    echo
    echo -e "  The installation is updated. Read the FAIL lines above: those"
    echo -e "  projects were NOT propagated to, and re-running is safe."
    echo
    exit 5
else
    echo -e "${RED}${BOLD}Done${NC}"
    echo
    # "when convenient" rather than "now": a session still attached to the old
    # build keeps working, it just does not have the new one yet. Telling
    # someone they are broken when they are not is how a message stops being read.
    echo -e "  Restart Claude Code when convenient to pick up the new server and hooks."
fi
echo
