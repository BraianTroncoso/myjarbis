#!/bin/bash
#
# MyJarbis Update
#
# WHY THIS WAS REWRITTEN
# ----------------------
# The previous version did nothing useful. It ran `git pull` inside
# $HOME/.myjarbis-global — but install.sh populates that directory with
# `cp -r`, so it is a COPY, not a clone. There is no remote to pull from, so
# every run printed "not a git repository, skipping update" and then rebuilt
# the code that was already there. It also never re-copied bin/ or
# templates/, which is where hook scripts live, so a new hook could never
# reach an existing installation.
#
# This version:
#   1. pulls the source checkout (recorded at install time in .source)
#   2. re-syncs code + templates + bin into the install dir, WITHOUT
#      touching the project registry
#   3. reinstalls dependencies and rebuilds
#   4. reports which registered projects are out of date — hook scripts and
#      schema version — and refreshes their hooks with --projects
#
# It never touches a project's memory.db. Schema changes are
# `myjarbis migrate`, which backs up first.
#
# The report asks `health --json` rather than inspecting each project itself;
# see the comment at step 5 for why that mattered. And because updating swaps
# the MCP server build out from under a running Claude session, there is a
# preflight check before step 1 — nothing is touched until it passes.

set -euo pipefail

RED='\033[38;5;88m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

INSTALL_DIR="${MYJARBIS_INSTALL_DIR:-$HOME/.myjarbis-global}"
REGISTRY_FILE="${MYJARBIS_REGISTRY:-$INSTALL_DIR/projects-registry.json}"

step() { echo -e "${RED}[$1/5]${NC}  ${BOLD}$2${NC}"; }
ok()   { echo "       OK"; }
note() { echo -e "       ${DIM}$1${NC}"; }
warn() { echo -e "       ${RED}WARN${NC}  $1"; }
fail() { echo -e "       ${RED}${BOLD}FAIL${NC}  $1"; }

# ── Never rewrite a file that something might be reading ──────────────────
#
# `cp` over an existing file rewrites it IN PLACE: same inode, new bytes. Any
# process reading that file keeps its handle and silently starts reading the
# new content. For a shell script that is fatal, because bash reads a script
# incrementally, by byte offset, rather than loading it whole — the next read
# returns the NEW bytes at the OLD offset and execution resumes mid-token.
#
# That is what crashed a real update on 2026-10-20. Step 3 copies $SOURCE/bin
# over $INSTALL_DIR/bin, and the script being executed IS
# $INSTALL_DIR/bin/myjarbis-update: it overwrote itself and died with
# `line 196: f: command not found` on a line where nothing was wrong. The bug
# had been latent through every release where the file length barely moved,
# because bash resumed close enough to a statement boundary to keep going.
# Steps 4 (rebuild) and 5 (report) never ran.
#
# `mv` is a rename: it swaps the directory entry and leaves the old inode
# alive for anyone still holding it open, so a running script reads the version
# it started with, all the way to the end. Copy beside the target, then rename
# over it.
#
# This is a property of the writer, not of the victim: the fix lives here, in
# the one place that does the replacing, so a script added to bin/ tomorrow is
# covered without its author knowing any of the above.
#
# Deliberately NOT used for the global/* trees, and the reason is the same
# mechanism rather than an exception to it: those are mcp-server/ (node_modules
# and symlinks included, ~1600 files), core/ and templates/, and nothing in
# them is executed incrementally by bash. Node reads a module file whole, so a
# replaced build/*.js either loads or fails loudly at import. The project hook
# refresh at step 5 is safe for the same reason this helper is: it `rm -rf`s
# before copying, and unlinking leaves the running process on the old inode.
sync_executables() {
    local src_dir="$1" dest_dir="$2" f base dest staged
    mkdir -p "$dest_dir"

    # A run that died mid-copy can leave a staging file behind. Sweeping them
    # first is what makes re-running the update a repair rather than a pile-up,
    # and keeps a half-written file from ever sitting next to the real commands.
    rm -f "$dest_dir"/.myjarbis-incoming.* 2>/dev/null || true

    for f in "$src_dir"/*; do
        base="$(basename "$f")"
        if [ ! -f "$f" ]; then
            # bin/ has only ever held plain scripts. Say so out loud rather
            # than skipping in silence, so the day that changes is the day
            # someone reads this instead of debugging a missing command.
            warn "$base is not a plain file — not synced into $dest_dir"
            continue
        fi
        dest="$dest_dir/$base"
        staged="$dest_dir/.myjarbis-incoming.$$-$base"
        cp "$f" "$staged"
        chmod +x "$staged"
        mv -f "$staged" "$dest"
    done
}

SYNC_PROJECTS=""
SOURCE_OVERRIDE=""
SKIP_PULL=""
ASSUME_YES=""
PROJECTS_ONLY=""

for arg in "$@"; do
    case "$arg" in
        --projects)   SYNC_PROJECTS=1 ;;
        # Repairing a project's hooks needs nothing from the checkout: the
        # templates and the build are already in the install dir. Reinstalling
        # both just to re-copy five shell scripts also swaps the MCP build out
        # from under a running Claude session for no reason.
        --projects-only) SYNC_PROJECTS=1; PROJECTS_ONLY=1 ;;
        --no-pull)    SKIP_PULL=1 ;;
        --yes|-y)     ASSUME_YES=1 ;;
        --from=*)     SOURCE_OVERRIDE="${arg#*=}" ;;
        --help|-h)
            echo "Usage: myjarbis update [--projects|--projects-only] [--no-pull] [--yes] [--from=<path>]"
            echo
            echo "  --projects       Also refresh hook scripts in every registered"
            echo "                   project (never touches memory.db)."
            echo "  --projects-only  Only do that. Skips the pull, the re-sync and"
            echo "                   the rebuild, so a running Claude session keeps"
            echo "                   working. Use this to fix unwired projects."
            echo "  --no-pull        Re-sync from the local checkout without pulling."
            echo "  --yes, -y        Do not ask anything, even with Claude Code running."
            echo "  --from=<path>    Use this checkout as the source and remember it."
            exit 0
            ;;
        *) echo "Unknown option: $arg (try --help)" >&2; exit 1 ;;
    esac
done

echo
echo -e "${RED}${BOLD}MyJarbis${NC} · update"
echo
echo -e "  ${BOLD}Install${NC}  $INSTALL_DIR"

if [ ! -d "$INSTALL_DIR" ]; then
    fail "MyJarbis is not installed at $INSTALL_DIR"
    note "clone the repo and run ./install.sh first"
    exit 1
fi

# ─── preflight: a running Claude session is about to lose its tools ──
#
# Updating rebuilds mcp-server/build in place, and that is the exact build a
# running Claude session is attached to. The old process keeps running against
# files that changed underneath it, so every mcp__myjarbis__* call starts
# failing with "Connection closed" — mid-session, with no explanation. The
# closing message already says to restart Claude Code; what it never said is
# that the session open RIGHT NOW is the one being broken, and by then it is
# too late to choose.
#
# This runs before step 1 on purpose: nothing has been touched yet, so
# answering "no" leaves the installation exactly as it was.
#
# `pgrep -x` matches the process name exactly, which is what keeps this from
# matching the shell running the update, or the grep itself. Absent pgrep
# (unlikely on Linux/macOS, possible in a bare container), the check is
# skipped rather than guessed at.
#
# Skipped entirely for --projects-only: that path never rebuilds, so the
# running session keeps the build it is attached to. Warning anyway would
# train people to ignore the warning on the run that does matter.
if [ -z "$PROJECTS_ONLY" ] && command -v pgrep >/dev/null 2>&1; then
    CLAUDE_PIDS="$(pgrep -x claude 2>/dev/null | tr '\n' ' ' | sed 's/ $//')" || CLAUDE_PIDS=""
    if [ -n "$CLAUDE_PIDS" ]; then
        # The warning prints even with --yes. That flag says "do not ask me",
        # not "do not tell me" — someone running this from a script still
        # needs to know a session is about to lose its tools.
        warn "Claude Code is running (PID ${CLAUDE_PIDS})"
        note "updating replaces the MCP server build that session is attached"
        note "to: it will lose every myjarbis tool and has to be restarted."
        if [ -z "$ASSUME_YES" ] && [ -t 0 ]; then
            # Same idiom as bin/myjarbis-init: ask only when someone is there
            # to answer. Non-interactive callers — the agent running this from
            # inside Claude, a script, CI — get the warning and proceed, which
            # is the behaviour that was chosen deliberately: blocking them
            # would make the update impossible from the place it is most often
            # requested.
            printf '       Update anyway? [y/N]: '
            read -r REPLY_UPDATE
            case "$REPLY_UPDATE" in
                y|Y|s|S|yes|YES|si|SI|sí|Sí) ;;
                *)
                    note "nothing was changed. Close Claude Code and re-run."
                    echo
                    exit 0
                    ;;
            esac
        elif [ -n "$ASSUME_YES" ]; then
            note "--yes given — continuing. Restart Claude when done."
        else
            note "no terminal to ask — continuing. Restart Claude when done."
        fi
        echo
    fi
fi

# ─── [1/5] locate the source checkout ─────────────────────────────
step 1 "Locate the source checkout"
SOURCE=""
if [ -n "$SOURCE_OVERRIDE" ]; then
    SOURCE="$SOURCE_OVERRIDE"
elif [ -f "$INSTALL_DIR/.source" ]; then
    SOURCE="$(cat "$INSTALL_DIR/.source")"
fi

if [ -z "$SOURCE" ] || [ ! -d "$SOURCE" ]; then
    # --projects-only reads nothing from the checkout, so a missing one is
    # not an error there. It is still worth resolving when available: step 5
    # uses it to refuse to overwrite the checkout with its own copy.
    if [ -n "$PROJECTS_ONLY" ]; then
        SOURCE=""
        note "no source checkout recorded — not needed for --projects-only"
        ok
    else
        fail "no usable source checkout"
        note "this installation predates update support, or the checkout moved."
        note "re-point it once and it will be remembered:"
        note "  myjarbis update --from=/path/to/myjarbis"
        exit 1
    fi
else
    SOURCE="$(cd "$SOURCE" && pwd)"
    if [ ! -d "$SOURCE/global" ] || [ ! -f "$SOURCE/install.sh" ]; then
        fail "$SOURCE does not look like a MyJarbis checkout (no global/ or install.sh)"
        exit 1
    fi
    # Only remembered on a run that actually syncs from it. --projects-only
    # may have been handed a --from purely to name the checkout to protect.
    [ -z "$PROJECTS_ONLY" ] && printf '%s\n' "$SOURCE" > "$INSTALL_DIR/.source"
    note "$SOURCE"
    ok
fi

# Steps 2-4 are what makes `update` an installation-level operation, and
# the whole point of --projects-only is to reach step 5 without them. They
# are announced as skipped rather than silently absent: the step numbers
# are how this output gets read.
if [ -n "$PROJECTS_ONLY" ]; then

step 2 "Pull latest changes"
note "skipped — --projects-only"
ok
step 3 "Sync code, templates and CLI"
note "skipped — --projects-only"
ok
step 4 "Install dependencies and rebuild"
note "skipped — --projects-only (the running build is left alone)"
ok

else

# ─── [2/5] pull ───────────────────────────────────────────────────
step 2 "Pull latest changes"
if [ -n "$SKIP_PULL" ]; then
    note "--no-pull given, using the checkout as it is"
elif [ -d "$SOURCE/.git" ]; then
    BRANCH="$(git -C "$SOURCE" rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)"
    if [ -n "$(git -C "$SOURCE" status --porcelain 2>/dev/null)" ]; then
        warn "the checkout has uncommitted changes — not pulling"
        note "installing what is in the working tree instead"
    elif git -C "$SOURCE" pull --ff-only 2>&1 | sed 's/^/       /'; then
        note "branch: $BRANCH"
    else
        warn "pull failed — installing the current checkout instead"
    fi
else
    note "not a git checkout, using the files as they are"
fi
ok

# ─── [3/5] sync files ─────────────────────────────────────────────
step 3 "Sync code, templates and CLI"
# The registry is state owned by this installation, and a developer's
# checkout can contain a stale copy of it. Never overwrite it.
REGISTRY_BACKUP=""
if [ -f "$REGISTRY_FILE" ]; then
    REGISTRY_BACKUP="$(mktemp)"
    cp "$REGISTRY_FILE" "$REGISTRY_BACKUP"
fi

for item in "$SOURCE"/global/*; do
    base="$(basename "$item")"
    [ "$base" = "projects-registry.json" ] && continue
    rm -rf "$INSTALL_DIR/$base.old" 2>/dev/null || true
    cp -r "$item" "$INSTALL_DIR/"
done
# By rename, not in place: this is the copy that used to kill the running
# update. See sync_executables at the top for why.
sync_executables "$SOURCE/bin" "$INSTALL_DIR/bin"
# Stray brains a checkout may have accumulated are not part of the product.
# backups/ is excluded: like the registry, it is state owned by this
# installation, not code coming from the checkout. The snapshots under it
# contain a project's own .myjarbis/ by design, and a sync must not eat them.
find "$INSTALL_DIR" \
    -path "$INSTALL_DIR/backups" -prune -o \
    -type d -name '.myjarbis' -prune -exec rm -rf {} + 2>/dev/null || true

if [ -n "$REGISTRY_BACKUP" ]; then
    cp "$REGISTRY_BACKUP" "$REGISTRY_FILE"
    rm -f "$REGISTRY_BACKUP"
    COUNT=$(node -e "
      try {
        const r = JSON.parse(require('fs').readFileSync('$REGISTRY_FILE','utf8'));
        console.log(Object.keys(r.projects || {}).length);
      } catch { console.log('?'); }
    ")
    note "registry preserved ($COUNT project(s))"
fi
ok

# ─── [4/5] dependencies + build ───────────────────────────────────
step 4 "Install dependencies and rebuild"
cd "$INSTALL_DIR/mcp-server"
npm install --silent 2>&1 | grep -v "npm WARN" || true
if npm run build 2>&1 | tail -1 | sed 's/^/       /'; then
    if [ -f "build/index.js" ]; then
        ok
    else
        fail "build produced no index.js"
        exit 1
    fi
else
    fail "build failed"
    exit 1
fi

VERSION=$(node -e "console.log(require('$INSTALL_DIR/mcp-server/package.json').version)" 2>/dev/null || echo '?')
SCHEMA=$(node --input-type=module -e "
  import { SCHEMA_VERSION } from '$INSTALL_DIR/mcp-server/build/db/schema.js';
  console.log(SCHEMA_VERSION);
" 2>/dev/null || echo '?')
note "mcp-server $VERSION · schema v$SCHEMA"

fi  # end of the steps 2-4 block skipped by --projects-only

# ─── [5/5] report (and optionally refresh) registered projects ────
step 5 "Check registered projects"
if [ ! -f "$REGISTRY_FILE" ]; then
    note "no registry yet — nothing to check"
    ok
else
    # Per project: are its hook scripts current, and is its brain on the
    # current schema? Reported separately because they are fixed by
    # different commands — one is a file copy, the other needs a backup.
    #
    # This asks `health --json` instead of working it out here. The previous
    # version looked for `<project>/.myjarbis/memory.db` with existsSync, and
    # the v4 shared-brain migration retired those files — so on any machine
    # that moved to the shared brain it reported "no brain yet" for EVERY
    # project and the "older schema" warning below could never fire. It was
    # also a worse copy of resolution logic that already exists: collectHealth
    # (global/mcp-server/src/health.ts) resolves each project the way the rest
    # of the system does and already returns schema, isolation and hook
    # staleness. One source of truth, and it has test coverage.
    REPORT=$(node "$INSTALL_DIR/mcp-server/build/cli.js" health --json 2>/dev/null | node -e "
let raw = '';
process.stdin.on('data', (d) => (raw += d));
process.stdin.on('end', () => {
  let report;
  try { report = JSON.parse(raw); } catch { process.exit(0); }
  for (const p of report.projects || []) {
    if (!p.pathExists) {
      console.log(['GONE', p.name, p.path || '?'].join('\t'));
      continue;
    }
    // schema === null now genuinely means 'this project has no brain',
    // rather than 'no brain file sits next to it'.
    const schema = p.schema === null ? 'none' : p.schemaCurrent ? 'current' : 'v' + p.schema;
    // p.wiring is the field that makes an unwired project visible. Scripts
    // can be byte-identical to the template and still be bound to nothing,
    // and that combination used to print as 'up to date'.
    console.log(
      ['OK', p.name, p.path, p.hooks, schema, p.isolation || '?', p.wiring || 'unknown'].join('\t'),
    );
  }
});
" 2>/dev/null || true)

    STALE_HOOKS=0
    UNWIRED_HOOKS=0
    OLD_SCHEMA=0
    while IFS=$'\t' read -r status name dir hooks schema isolation wiring; do
        [ -z "${status:-}" ] && continue
        if [ "$status" = "GONE" ]; then
            note "$name — path is gone, skipping ($dir)"
            continue
        fi
        LINE="$name"
        # Where the brain lives, so a wrong schema reading is visible at a
        # glance instead of having to be trusted. This is the field whose
        # absence hid the bug: everything read "no brain yet" and looked fine.
        [ -n "${isolation:-}" ] && [ "$isolation" != "?" ] && LINE="$LINE · $isolation"
        [ "$hooks" != "current" ] && { LINE="$LINE · hooks $hooks"; STALE_HOOKS=$((STALE_HOOKS+1)); }
        # Separate from staleness on purpose: 'stale' is repaired by copying
        # the template, 'unwired' by `hook install claude`. A project can need
        # one, the other, or both.
        case "${wiring:-unknown}" in
            wired|unknown) ;;
            *) LINE="$LINE · $wiring"; UNWIRED_HOOKS=$((UNWIRED_HOOKS+1)) ;;
        esac
        [ "$schema" != "current" ] && [ "$schema" != "none" ] && { LINE="$LINE · schema $schema"; OLD_SCHEMA=$((OLD_SCHEMA+1)); }
        # "none" means the project has no brain at all, which is not staleness.
        if [ "$hooks" = "current" ] && [ "${wiring:-unknown}" != "unwired" ] \
           && [ "${wiring:-unknown}" != "partial" ] \
           && { [ "$schema" = "current" ] || [ "$schema" = "none" ]; }; then
            LINE="$LINE · up to date"
            [ "$schema" = "none" ] && LINE="$LINE (no brain yet)"
        fi
        note "$LINE"
    done <<< "$REPORT"

    NEEDS_HOOKS=$((STALE_HOOKS + UNWIRED_HOOKS))
    if [ -n "$SYNC_PROJECTS" ] && [ "$NEEDS_HOOKS" -gt 0 ]; then
        echo
        # Hooks only. This used to say "hooks + commands", which was never
        # true: the loop below copies .claude-plugin/ and nothing else.
        # Commands are files in .claude/commands/ and have their own
        # propagation path, `myjarbis commands sync`.
        note "refreshing hooks in $NEEDS_HOOKS project(s)..."
        while IFS=$'\t' read -r status name dir hooks schema isolation wiring; do
            [ "${status:-}" != "OK" ] && continue
            # The skip condition used to be `hooks = current` alone, which
            # excluded every project whose scripts were fresh but bound to
            # nothing — i.e. all the ones that most needed this loop. Only
            # skip when BOTH questions come back clean.
            WANT_COPY=1; WANT_WIRE=1
            [ "$hooks" = "current" ] && WANT_COPY=
            case "${wiring:-unknown}" in wired) WANT_WIRE= ;; esac
            [ -z "$WANT_COPY" ] && [ -z "$WANT_WIRE" ] && continue

            # Never overwrite the source checkout with the installed copy.
            # This repo tracks templates/.claude-plugin as the original; the
            # template we copy FROM is a snapshot of it. When they differ it
            # is normally because the checkout is ahead, so refreshing here
            # would silently revert work in progress.
            if [ -n "$SOURCE" ] && [ "$(cd "$dir" 2>/dev/null && pwd)" = "$SOURCE" ]; then
                note "  $name — source checkout, not refreshing from its own copy"
                continue
            fi

            if [ -n "$WANT_COPY" ] && [ -d "$INSTALL_DIR/templates/.claude-plugin" ]; then
                rm -rf "$dir/.claude-plugin"
                cp -r "$INSTALL_DIR/templates/.claude-plugin" "$dir/.claude-plugin"
                chmod +x "$dir"/.claude-plugin/scripts/*.sh 2>/dev/null || true
            fi
            # Re-assert the wiring whether or not we copied. Refreshing the
            # scripts without it would leave a project that predates the
            # wiring with new scripts nobody runs, and a project with fresh
            # scripts and no wiring needs only this half.
            if ( cd "$dir" && node "$INSTALL_DIR/mcp-server/build/cli.js" hook install claude ) >/dev/null 2>&1; then
                if [ -n "$WANT_COPY" ]; then
                    note "  $name — hooks refreshed and wired"
                else
                    note "  $name — hooks wired (scripts were already current)"
                fi
            else
                note "  $name — wiring failed (run, from inside it: myjarbis hook install claude)"
            fi
        done <<< "$REPORT"
    elif [ "$NEEDS_HOOKS" -gt 0 ]; then
        echo
        [ "$STALE_HOOKS" -gt 0 ] && warn "$STALE_HOOKS project(s) have out-of-date hook scripts"
        # Worth its own line: the scripts are fine, so nothing looks wrong
        # until you notice the session greeting never appears.
        [ "$UNWIRED_HOOKS" -gt 0 ] && warn "$UNWIRED_HOOKS project(s) have hooks bound to no event — they never run"
        note "fix them with: myjarbis update --projects"
        note "(it replaces .claude-plugin/ and rewrites .claude/settings.local.json — memory.db is never touched)"
    fi

    note "slash commands are not part of this: myjarbis commands sync --all"

    if [ "$OLD_SCHEMA" -gt 0 ]; then
        echo
        warn "$OLD_SCHEMA project(s) are on an older schema"
        note "they keep working as-is. To upgrade, from inside each project:"
        note "  myjarbis migrate --dry-run     # report, change nothing"
        note "  myjarbis migrate               # backs up first, WAL included"
        note "deliberately NOT automatic: a schema change should be something"
        note "you chose, with a backup you know about."
    fi
    ok
fi

echo
echo -e "${RED}${BOLD}Done${NC}"
echo
echo -e "  Restart Claude Code to pick up the new server and hooks."
echo
