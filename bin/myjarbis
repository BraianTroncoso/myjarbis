#!/bin/bash

#
# MyJarbis CLI - Main Entry Point
#
# Commands:
#   myjarbis init       - Initialize current project
#   myjarbis list       - List all registered projects
#   myjarbis context    - Generate fresh codebase context
#   myjarbis update     - Update MyJarbis global installation
#   myjarbis help       - Show help
#

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Paths
INSTALL_DIR="${MYJARBIS_INSTALL_DIR:-$HOME/.myjarbis-global}"
REGISTRY_FILE="$INSTALL_DIR/projects-registry.json"

# Show help
show_help() {
    echo ""
    echo "MyJarbis - AI Development Assistant System"
    echo ""
    echo "Usage: myjarbis <command> [options]"
    echo ""
    echo "Commands:"
    echo "  init        Initialize MyJarbis in the current project"
    echo "  doctor      Run diagnostics to verify installation and setup"
    echo "  list        List all projects registered with MyJarbis"
    echo "  context     Refresh project context (re-analyze project structure)"
    echo "  update      Update MyJarbis global installation"
    echo "  import      Import a .md or .json file into the project DB"
    echo "  module      Manage modules (add/list)"
    echo "  skill       Manage skills (add/list/edit/delete/enable/disable)"
    echo "  stats       Show counts per table for the active project"
    echo "  help        Show this help message"
    echo ""
    echo "Examples:"
    echo "  cd ~/projects/my-app"
    echo "  myjarbis init              # Initialize project"
    echo "  myjarbis doctor            # Check if everything works"
    echo "  myjarbis list              # See all projects"
    echo ""
    echo "Documentation:"
    echo "  https://github.com/braiantroncoso/myjarbis"
    echo ""
}

# List registered projects
list_projects() {
    if [ ! -f "$REGISTRY_FILE" ]; then
        echo -e "${YELLOW}No projects registered yet${NC}"
        echo "Run 'myjarbis init' in a project to register it"
        exit 0
    fi

    # Parse JSON and list projects
    echo ""
    echo "Registered Projects:"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    # Use node to parse JSON (works cross-platform)
    node -e "
        const fs = require('fs');
        const data = JSON.parse(fs.readFileSync('$REGISTRY_FILE', 'utf-8'));
        const projects = data.projects;

        if (Object.keys(projects).length === 0) {
            console.log('  No projects registered yet');
        } else {
            for (const [name, config] of Object.entries(projects)) {
                console.log('');
                console.log('  Name:      ' + name);
                console.log('  Path:      ' + config.path);
                console.log('  Framework: ' + (config.framework || 'generic'));
                console.log('  Created:   ' + config.initialized);
            }
        }
    "

    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
}

# Generate/refresh project context
generate_context() {
    if [ ! -d ".myjarbis" ]; then
        echo -e "${RED}Error: Not a MyJarbis project${NC}"
        echo "Run 'myjarbis init' first"
        exit 1
    fi

    echo ""
    echo -e "${BLUE}Refreshing project context...${NC}"
    echo ""

    # Project structure analysis is delegated to Claude via the
    # framework-detect skill (introduced in Phase 3 of the v0.2 upgrade).
    # The legacy JS analyzers (global/core/analyzers/*.js) never existed
    # in the repo — the previous code attempted to call them and silently
    # fell back to a static template, masking the bug.
    if [ -f ".myjarbis/config/settings.json" ]; then
        echo -e "${BLUE}[1/2]${NC} project-summary.md update skipped"
        echo -e "       ${NC}Re-analysis now happens inside Claude via the${NC}"
        echo -e "       ${NC}'framework-detect' skill. Open Claude in this${NC}"
        echo -e "       ${NC}project and ask the agent to refresh the summary.${NC}"
    else
        echo -e "${YELLOW}!${NC} Settings not found, skipping project-summary update"
    fi

    # Generate codebase.txt (optional)
    if [ -f ".myjarbis/bin/generate-context.sh" ]; then
        echo ""
        echo -e "${BLUE}[2/2]${NC} Generating codebase.txt (optional)..."
        bash .myjarbis/bin/generate-context.sh
        echo -e "${GREEN}✓${NC} codebase.txt generated"
    fi

    echo ""
    echo -e "${GREEN}Context refresh complete!${NC}"
    echo ""
    echo "Updated files:"
    echo "  - .myjarbis/context/project-summary.md (Claude reads this)"
    if [ -f ".myjarbis/context/codebase.txt" ]; then
        echo "  - .myjarbis/context/codebase.txt (optional reference)"
    fi
    echo ""
}

# Main command router
case "${1:-help}" in
    init)
        if [ ! -f "$INSTALL_DIR/bin/myjarbis-init" ]; then
            echo -e "${RED}Error: MyJarbis not properly installed${NC}"
            echo "Please run the installation script"
            exit 1
        fi
        exec "$INSTALL_DIR/bin/myjarbis-init"
        ;;

    doctor)
        if [ ! -f "$INSTALL_DIR/bin/myjarbis-doctor" ]; then
            echo -e "${RED}Error: MyJarbis not properly installed${NC}"
            echo "Please run the installation script"
            exit 1
        fi
        exec "$INSTALL_DIR/bin/myjarbis-doctor"
        ;;

    list)
        list_projects
        ;;

    context)
        generate_context
        ;;

    update)
        if [ ! -f "$INSTALL_DIR/bin/myjarbis-update" ]; then
            echo -e "${RED}Error: MyJarbis not properly installed${NC}"
            exit 1
        fi
        exec "$INSTALL_DIR/bin/myjarbis-update"
        ;;

    import|module|skill|stats)
        # v0.2 subcommands delegated to the node CLI helper
        CLI_JS="$INSTALL_DIR/mcp-server/build/cli.js"
        if [ ! -f "$CLI_JS" ]; then
            echo -e "${RED}Error: cli.js not found at $CLI_JS${NC}"
            echo "Re-run the installer or rebuild: cd $INSTALL_DIR/mcp-server && npm run build"
            exit 1
        fi
        exec node "$CLI_JS" "$@"
        ;;

    help|--help|-h)
        show_help
        ;;

    --version|-v)
        echo "MyJarbis v0.2.0"
        ;;

    *)
        echo -e "${RED}Error: Unknown command '${1}'${NC}"
        echo "Run 'myjarbis help' for usage"
        exit 1
        ;;
esac
