#!/bin/bash
#
# MyJarbis CLI — Main Entry Point
#

set -e

# Minimal palette: blood red as the only accent.
RED='\033[38;5;88m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# Paths
INSTALL_DIR="${MYJARBIS_INSTALL_DIR:-$HOME/.myjarbis-global}"
REGISTRY_FILE="$INSTALL_DIR/projects-registry.json"

show_help() {
    echo
    echo -e "${RED}${BOLD}MyJarbis${NC}"
    echo
    echo "  Usage: myjarbis <command> [options]"
    echo
    echo -e "${RED}${BOLD}Commands${NC}"
    echo
    echo -e "  ${BOLD}init${NC}       Initialize MyJarbis in the current project"
    echo -e "  ${BOLD}doctor${NC}     Verify installation and project setup"
    echo -e "  ${BOLD}list${NC}       List all registered projects"
    echo -e "  ${BOLD}context${NC}    Refresh project context"
    echo -e "  ${BOLD}update${NC}     Update MyJarbis global installation"
    echo -e "  ${BOLD}import${NC}     Import a .md or .json into the project DB"
    echo -e "  ${BOLD}module${NC}     Manage modules (add/list)"
    echo -e "  ${BOLD}skill${NC}      Manage skills (add/list/edit/delete/enable/disable)"
    echo -e "  ${BOLD}stats${NC}      Show row counts per table"
    echo -e "  ${BOLD}cost${NC}       Show token usage and cost from Claude Code logs"
    echo -e "  ${BOLD}help${NC}       Show this help"
    echo
    echo -e "${RED}${BOLD}Examples${NC}"
    echo
    echo "  cd ~/projects/my-app"
    echo "  myjarbis init"
    echo "  myjarbis doctor"
    echo "  myjarbis list"
    echo
    echo -e "  ${DIM}https://github.com/braiantroncoso/myjarbis${NC}"
    echo
}

list_projects() {
    if [ ! -f "$REGISTRY_FILE" ]; then
        echo
        echo -e "  ${RED}WARN${NC}  no projects registered"
        echo -e "        ${DIM}run 'myjarbis init' in a project to register it${NC}"
        echo
        exit 0
    fi

    echo
    echo -e "${RED}${BOLD}Registered projects${NC}"
    echo

    node -e "
        const fs = require('fs');
        const data = JSON.parse(fs.readFileSync('$REGISTRY_FILE', 'utf-8'));
        const projects = data.projects;

        if (Object.keys(projects).length === 0) {
            console.log('  (none)');
        } else {
            for (const [name, config] of Object.entries(projects)) {
                console.log('  ' + name);
                console.log('    path       ' + config.path);
                console.log('    framework  ' + (config.framework || 'generic'));
                console.log('    created    ' + config.initialized);
                console.log('');
            }
        }
    "
}

generate_context() {
    if [ ! -d ".myjarbis" ]; then
        echo
        echo -e "  ${RED}${BOLD}FAIL${NC}  not a MyJarbis project"
        echo -e "        ${DIM}run 'myjarbis init' first${NC}"
        echo
        exit 1
    fi

    echo
    echo -e "${RED}${BOLD}MyJarbis${NC} · refresh project context"
    echo

    # Project structure analysis is delegated to the framework-detect skill
    # (Phase 3 of the v0.2 upgrade). The legacy JS analyzers under
    # global/core/analyzers/ never existed.
    if [ -f ".myjarbis/config/settings.json" ]; then
        echo -e "  ${RED}[1/2]${NC}  ${BOLD}project-summary.md${NC}"
        echo -e "         ${DIM}re-analysis happens inside Claude via the${NC}"
        echo -e "         ${DIM}framework-detect skill — open Claude and ask${NC}"
        echo -e "         ${DIM}the agent to refresh the summary${NC}"
    else
        echo -e "  ${RED}WARN${NC}  settings not found, skipping"
    fi

    if [ -f ".myjarbis/bin/generate-context.sh" ]; then
        echo
        echo -e "  ${RED}[2/2]${NC}  ${BOLD}codebase.txt${NC}"
        bash .myjarbis/bin/generate-context.sh
        echo "         OK"
    fi

    echo
    echo -e "  ${BOLD}done${NC}"
    if [ -f ".myjarbis/context/codebase.txt" ]; then
        echo -e "    ${DIM}.myjarbis/context/codebase.txt${NC}"
    fi
    echo
}

# Main command router
case "${1:-help}" in
    init)
        # Resolve script: prefer $INSTALL_DIR/bin (production install
        # layout), fall back to $INSTALL_DIR/../bin (dev layout where
        # MYJARBIS_INSTALL_DIR points to <repo>/global).
        if [ -f "$INSTALL_DIR/bin/myjarbis-init" ]; then
            exec "$INSTALL_DIR/bin/myjarbis-init"
        elif [ -f "$INSTALL_DIR/../bin/myjarbis-init" ]; then
            exec "$INSTALL_DIR/../bin/myjarbis-init"
        fi
        echo -e "  ${RED}${BOLD}FAIL${NC}  myjarbis-init not found"
        echo -e "        ${DIM}run ./install.sh or set MYJARBIS_INSTALL_DIR${NC}"
        exit 1
        ;;

    doctor)
        if [ -f "$INSTALL_DIR/bin/myjarbis-doctor" ]; then
            exec "$INSTALL_DIR/bin/myjarbis-doctor"
        elif [ -f "$INSTALL_DIR/../bin/myjarbis-doctor" ]; then
            exec "$INSTALL_DIR/../bin/myjarbis-doctor"
        fi
        echo -e "  ${RED}${BOLD}FAIL${NC}  myjarbis-doctor not found"
        echo -e "        ${DIM}run ./install.sh or set MYJARBIS_INSTALL_DIR${NC}"
        exit 1
        ;;

    list)
        list_projects
        ;;

    context)
        generate_context
        ;;

    update)
        if [ -f "$INSTALL_DIR/bin/myjarbis-update" ]; then
            exec "$INSTALL_DIR/bin/myjarbis-update"
        elif [ -f "$INSTALL_DIR/../bin/myjarbis-update" ]; then
            exec "$INSTALL_DIR/../bin/myjarbis-update"
        fi
        echo -e "  ${RED}${BOLD}FAIL${NC}  myjarbis-update not found"
        exit 1
        ;;

    import|module|skill|stats|cost)
        # v0.2 subcommands delegated to the node CLI helper
        CLI_JS="$INSTALL_DIR/mcp-server/build/cli.js"
        if [ ! -f "$CLI_JS" ]; then
            echo -e "  ${RED}${BOLD}FAIL${NC}  cli.js not found at $CLI_JS"
            echo -e "        ${DIM}re-run the installer or rebuild: cd $INSTALL_DIR/mcp-server && npm run build${NC}"
            exit 1
        fi
        exec node "$CLI_JS" "$@"
        ;;

    help|--help|-h)
        show_help
        ;;

    --version|-v)
        echo "MyJarbis v0.2.0"
        ;;

    *)
        echo -e "  ${RED}${BOLD}FAIL${NC}  unknown command: ${1}"
        echo -e "        ${DIM}run 'myjarbis help' for usage${NC}"
        exit 1
        ;;
esac
