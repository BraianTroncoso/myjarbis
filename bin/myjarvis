#!/bin/bash

#
# MyJarvis CLI - Main Entry Point
#
# Commands:
#   myjarvis init       - Initialize current project
#   myjarvis list       - List all registered projects
#   myjarvis context    - Generate fresh codebase context
#   myjarvis update     - Update MyJarvis global installation
#   myjarvis help       - Show help
#

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Paths
INSTALL_DIR="$HOME/.myjarvis-global"
REGISTRY_FILE="$INSTALL_DIR/projects-registry.json"

# Show help
show_help() {
    echo ""
    echo "MyJarvis - AI Development Assistant System"
    echo ""
    echo "Usage: myjarvis <command> [options]"
    echo ""
    echo "Commands:"
    echo "  init        Initialize MyJarvis in the current project"
    echo "  list        List all projects registered with MyJarvis"
    echo "  context     Refresh project context (re-analyze project structure)"
    echo "  update      Update MyJarvis global installation"
    echo "  help        Show this help message"
    echo ""
    echo "Examples:"
    echo "  cd ~/projects/my-app"
    echo "  myjarvis init              # Initialize project"
    echo "  myjarvis list              # See all projects"
    echo ""
    echo "Documentation:"
    echo "  https://github.com/braiantroncoso/myjarvis"
    echo ""
}

# List registered projects
list_projects() {
    if [ ! -f "$REGISTRY_FILE" ]; then
        echo -e "${YELLOW}No projects registered yet${NC}"
        echo "Run 'myjarvis init' in a project to register it"
        exit 0
    fi

    # Parse JSON and list projects
    echo ""
    echo "Registered Projects:"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    # Use node to parse JSON (works cross-platform)
    node -e "
        const fs = require('fs');
        const data = JSON.parse(fs.readFileSync('$REGISTRY_FILE', 'utf-8'));
        const projects = data.projects;

        if (Object.keys(projects).length === 0) {
            console.log('  No projects registered yet');
        } else {
            for (const [name, config] of Object.entries(projects)) {
                console.log('');
                console.log('  Name:      ' + name);
                console.log('  Path:      ' + config.path);
                console.log('  Framework: ' + (config.framework || 'generic'));
                console.log('  Created:   ' + config.initialized);
            }
        }
    "

    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
}

# Generate/refresh project context
generate_context() {
    if [ ! -d ".myjarvis" ]; then
        echo -e "${RED}Error: Not a MyJarvis project${NC}"
        echo "Run 'myjarvis init' first"
        exit 1
    fi

    echo ""
    echo -e "${BLUE}Refreshing project context...${NC}"
    echo ""

    # Detect framework from settings
    if [ -f ".myjarvis/config/settings.json" ]; then
        FRAMEWORK=$(grep -o '"framework"[[:space:]]*:[[:space:]]*"[^"]*"' .myjarvis/config/settings.json | cut -d'"' -f4)
        PROJECT_NAME=$(basename "$(pwd)")

        # Re-run appropriate analyzer
        if [ "$FRAMEWORK" = "laravel" ] && [ -f "$INSTALL_DIR/core/analyzers/laravel-analyzer.js" ]; then
            echo -e "${BLUE}[1/2]${NC} Re-analyzing Laravel project..."
            node "$INSTALL_DIR/core/analyzers/laravel-analyzer.js" "$(pwd)" "$PROJECT_NAME" > .myjarvis/context/project-summary.md 2>/dev/null && \
                echo -e "${GREEN}✓${NC} project-summary.md updated with latest code structure" || \
                echo -e "${YELLOW}!${NC} Could not re-analyze (using existing summary)"

        elif [ "$FRAMEWORK" = "express" ] && [ -f "$INSTALL_DIR/core/analyzers/express-analyzer.js" ]; then
            echo -e "${BLUE}[1/2]${NC} Re-analyzing Express project..."
            node "$INSTALL_DIR/core/analyzers/express-analyzer.js" "$(pwd)" "$PROJECT_NAME" > .myjarvis/context/project-summary.md 2>/dev/null && \
                echo -e "${GREEN}✓${NC} project-summary.md updated with latest code structure" || \
                echo -e "${YELLOW}!${NC} Could not re-analyze (using existing summary)"

        else
            echo -e "${BLUE}[1/2]${NC} Re-analyzing project structure..."
            if [ -f "$INSTALL_DIR/core/analyzers/generic-analyzer.js" ]; then
                node "$INSTALL_DIR/core/analyzers/generic-analyzer.js" "$(pwd)" "$PROJECT_NAME" > .myjarvis/context/project-summary.md 2>/dev/null && \
                    echo -e "${GREEN}✓${NC} project-summary.md updated" || \
                    echo -e "${YELLOW}!${NC} Could not re-analyze (using existing summary)"
            else
                echo -e "${YELLOW}!${NC} Analyzer not found, skipping project-summary update"
            fi
        fi
    else
        echo -e "${YELLOW}!${NC} Settings not found, skipping project-summary update"
    fi

    # Generate codebase.txt (optional)
    if [ -f ".myjarvis/bin/generate-context.sh" ]; then
        echo ""
        echo -e "${BLUE}[2/2]${NC} Generating codebase.txt (optional)..."
        bash .myjarvis/bin/generate-context.sh
        echo -e "${GREEN}✓${NC} codebase.txt generated"
    fi

    echo ""
    echo -e "${GREEN}Context refresh complete!${NC}"
    echo ""
    echo "Updated files:"
    echo "  - .myjarvis/context/project-summary.md (Claude reads this)"
    if [ -f ".myjarvis/context/codebase.txt" ]; then
        echo "  - .myjarvis/context/codebase.txt (optional reference)"
    fi
    echo ""
}

# Main command router
case "${1:-help}" in
    init)
        if [ ! -f "$INSTALL_DIR/bin/myjarvis-init" ]; then
            echo -e "${RED}Error: MyJarvis not properly installed${NC}"
            echo "Please run the installation script"
            exit 1
        fi
        exec "$INSTALL_DIR/bin/myjarvis-init"
        ;;

    list)
        list_projects
        ;;

    context)
        generate_context
        ;;

    update)
        if [ ! -f "$INSTALL_DIR/bin/myjarvis-update" ]; then
            echo -e "${RED}Error: MyJarvis not properly installed${NC}"
            exit 1
        fi
        exec "$INSTALL_DIR/bin/myjarvis-update"
        ;;

    help|--help|-h)
        show_help
        ;;

    --version|-v)
        echo "MyJarvis v0.1.0"
        ;;

    *)
        echo -e "${RED}Error: Unknown command '${1}'${NC}"
        echo "Run 'myjarvis help' for usage"
        exit 1
        ;;
esac
