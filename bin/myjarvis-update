#!/bin/bash

#
# MyJarvis Update Script
#
# Updates the global MyJarvis installation:
# 1. Pulls latest changes (if git repo)
# 2. Rebuilds MCP server
# 3. Optionally updates templates in existing projects
#

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Paths
INSTALL_DIR="$HOME/.myjarvis-global"

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  MyJarvis Update"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# Check if installed
if [ ! -d "$INSTALL_DIR" ]; then
    echo -e "${RED}Error: MyJarvis is not installed${NC}"
    echo "Run the installation script first"
    exit 1
fi

# Navigate to install directory
cd "$INSTALL_DIR"

# Check if it's a git repository
if [ -d ".git" ]; then
    echo -e "${BLUE}[1/3]${NC} Pulling latest changes..."
    git pull origin main || git pull origin master
    echo -e "${GREEN}✓${NC} Updated from repository"
else
    echo -e "${YELLOW}!${NC} Not a git repository, skipping update"
    echo "To enable updates, clone MyJarvis instead of copying files"
fi

# Reinstall dependencies
echo ""
echo -e "${BLUE}[2/3]${NC} Updating MCP server dependencies..."
cd "$INSTALL_DIR/mcp-server"
npm install --silent
echo -e "${GREEN}✓${NC} Dependencies updated"

# Rebuild
echo ""
echo -e "${BLUE}[3/3]${NC} Rebuilding MCP server..."
npm run build --silent
echo -e "${GREEN}✓${NC} MCP server rebuilt"

# Success
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo -e "${GREEN}Update completed!${NC}"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "MyJarvis has been updated to the latest version."
echo ""
echo "If you have Claude Code running, restart it to use the updated version:"
echo "  - Close Claude Code"
echo "  - Run: claude"
echo ""
